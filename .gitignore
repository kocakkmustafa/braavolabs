# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Keys / certs / service accounts — never commit (IAP, Apple .p8, etc.)
*.pem
*.p8
*.p12
*.key
*-service-account*.json

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store

# Docker volumes
docker-data/

# Runtime company data
COMPANIES/*
!COMPANIES/.gitkeep

# Prisma
packages/db/prisma/migrations/*_migration_lock.toml

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Turbo
.turbo/
scheduled_tasks.lock

# Claude Code internal tooling — agent definitions, slash commands, hooks,
# launch configs, per-agent worktrees. None of this is required to build
# or run the product; keep it local-only.
.claude/

# Local automation runtime state — generated, never committed.
HOLDING_CORE/

# iCloud/Finder duplicate copies ("file 2.ts", "dir 2/") — macOS sync
# artifacts that must never be tracked.
* 2
* 2.*
* 2/
