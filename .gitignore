# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store

# Docker volumes
docker-data/

# Runtime company data
COMPANIES/*
!COMPANIES/.gitkeep

# Prisma
packages/db/prisma/migrations/*_migration_lock.toml

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Turbo
.turbo/
scheduled_tasks.lock

# Claude Code internal tooling — agent definitions, slash commands, hooks,
# launch configs, per-agent worktrees. None of this is required to build
# or run the product; keep it local-only.
.claude/

# Cowork / automation runtime state — regenerated on every cron tick,
# committing would create meaningless diffs.
HOLDING_CORE/competitor-state.json
HOLDING_CORE/*-state.json
HOLDING_CORE/*.runtime.json
