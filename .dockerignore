node_modules
.git
.gitignore
.env
.env.*
.next
dist
.turbo
# Workspace packages carry their own install/build output on a dev machine:
# nested node_modules are symlinks into the host pnpm store and would overwrite
# the image's installed modules at `COPY . .`; .next alone is ~1 GB.
**/node_modules
**/.env
**/.env.*
**/.next
**/dist
**/.turbo
.DS_Store
*.log
.claude
COMPANIES
*.md
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml

# Local agent and account credential files are not container build inputs.
**/.mcp.json
**/.mcp.*.json
**/.codex/
**/.agents/
**/.aws/
**/.ssh/
**/.gnupg/
