{
  "name": "ai-company-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI Company OS — Autonomous AI company creation platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ai-company-os/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @ai-company-os/db exec prisma db seed",
    "db:generate": "pnpm --filter @ai-company-os/db exec prisma generate",
    "docker:up": "cd ENV && docker compose up -d",
    "docker:down": "cd ENV && docker compose down",
    "clean": "turbo run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "turbo": "^2.9.6"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "pino-pretty": "^13.1.3"
  },
  "pnpm": {
    "overrides": {
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "protobufjs": ">=7.5.5"
    },
    "auditConfig": {
      "ignoreCves": ["CVE-2024-45296"]
    }
  }
}
