{
  "name": "Autonomous Content Studio",
  "description": "Multi-channel content production — blog, social, video scripts, ad copy.",
  "primitives": ["CONTENT", "ANALYTICS", "DELIVERY", "MEMORY"],
  "agents": [
    {
      "name": "Content Strategist",
      "role": "strategist",
      "tools": ["analyze_trends", "generate_report", "recall_memory"]
    },
    {
      "name": "Writer",
      "role": "writer",
      "tools": ["generate_post", "create_draft", "edit_draft"]
    },
    {
      "name": "Publisher",
      "role": "publisher",
      "tools": ["schedule_content", "notify_client"]
    }
  ],
  "pipelines": [
    {
      "name": "Weekly Content Batch",
      "trigger": "SCHEDULED",
      "schedule": "0 8 * * 1",
      "steps": [
        { "name": "plan_content", "agentRole": "strategist", "order": 1 },
        { "name": "write_content", "agentRole": "writer", "order": 2 },
        { "name": "review_and_publish", "agentRole": "publisher", "order": 3 }
      ]
    }
  ]
}
