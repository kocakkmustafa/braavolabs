{
  "name": "SaaS Company",
  "description": "Full-stack SaaS business operations — sales, support, content, finance.",
  "primitives": ["ACQUISITION", "SALES", "DELIVERY", "CONTENT", "OPERATIONS", "FINANCE", "ANALYTICS", "MEMORY", "GOVERNANCE"],
  "agents": [
    {
      "name": "Sales Agent",
      "role": "sales_agent",
      "tools": ["find_leads", "create_deal", "update_deal_stage"]
    },
    {
      "name": "Content Creator",
      "role": "content_creator",
      "tools": ["generate_post", "create_draft", "schedule_content"]
    },
    {
      "name": "Operations Manager",
      "role": "ops_manager",
      "tools": ["create_task", "assign_task", "update_workflow"]
    },
    {
      "name": "Finance Agent",
      "role": "finance",
      "tools": ["create_invoice", "track_expense", "generate_report"]
    }
  ],
  "pipelines": [
    {
      "name": "Daily Operations",
      "trigger": "SCHEDULED",
      "schedule": "0 9 * * 1-5",
      "steps": [
        { "name": "check_tasks", "agentRole": "ops_manager", "order": 1 },
        { "name": "process_leads", "agentRole": "sales_agent", "order": 2 },
        { "name": "create_content", "agentRole": "content_creator", "order": 3 }
      ]
    }
  ]
}
