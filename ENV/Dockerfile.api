# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG COREPACK_BOOTSTRAP=corepack_online
FROM scratch AS corepack_archive

# Node 26 does not bundle Corepack. Keep bootstrap inputs immutable and avoid
# installing a second package manager just to run the pinned pnpm release.
FROM scratch AS pnpm_origin
ADD --checksum=sha256:9bee59c7313a216722c079c1e22160dea7f88df4e0c3450b1d7b01b882336c6a https://registry.npmjs.org/pnpm/-/pnpm-9.15.4.tgz /pnpm-9.15.4.tgz

FROM node:26.9.0-alpine@sha256:dbaa92e5758cbbcf85d65d5403fdb530fe3442cbe8c6dbfb7ef23365450d5070 AS corepack_online
RUN --network=none --mount=type=bind,from=pnpm_origin,source=/,target=/run/pnpm-origin,ro <<'PNPM'
set -eu
mkdir -p /usr/local/lib/pnpm-9.15.4
tar -xzf /run/pnpm-origin/pnpm-9.15.4.tgz -C /usr/local/lib/pnpm-9.15.4 --strip-components=1
ln -sf /usr/local/lib/pnpm-9.15.4/bin/pnpm.cjs /usr/local/bin/pnpm
ln -sf /usr/local/lib/pnpm-9.15.4/bin/pnpx.cjs /usr/local/bin/pnpx
test "$(node --version)" = v26.9.0
test "$(pnpm --version)" = 9.15.4
PNPM

FROM node:26.9.0-alpine@sha256:dbaa92e5758cbbcf85d65d5403fdb530fe3442cbe8c6dbfb7ef23365450d5070 AS corepack_offline
RUN --network=none --mount=type=bind,from=corepack_archive,source=/,target=/run/corepack-archive,ro <<'COREPACK'
set -eu
archive=/run/corepack-archive/corepack-pnpm-9.15.4-node26-v1.tgz
manifest=/run/corepack-archive/COREPACK-CONTEXT-MANIFEST.json
count="$(find /run/corepack-archive -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
test "$count" -eq 2
test -f "$archive" && test ! -L "$archive"
test -f "$manifest" && test ! -L "$manifest"
test "$(wc -c < "$archive" | tr -d ' ')" = 3858114
test "$(sha256sum "$archive" | awk '{print $1}')" = 377e4092a114e8a919900faf6db7ff503de953ea85c587cef79f46ec2628289c
node -e 'const fs=require("fs");const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));if(m.schema!==2||m.archive!=="corepack-pnpm-9.15.4-node26-v1.tgz"||m.archiveBytes!==3858114||m.archiveSha256!=="377e4092a114e8a919900faf6db7ff503de953ea85c587cef79f46ec2628289c"||m.corepack?.name!=="pnpm"||m.corepack?.version!=="9.15.4"||m.corepack?.embeddedSha512Hex!=="b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"||m.origin?.url!=="https://registry.npmjs.org/pnpm/-/pnpm-9.15.4.tgz"||m.origin?.integrity!=="sha512-stwg4vxys+GISEWbNzWaMgZGY+VielHkx0ssKd2OjgSRSDw6u0B4nP1Xi/Ni+2uoJhsF8Dh9dnku1uI+o7G2oA=="||m.producer?.recipe!=="canonical-tar-gzip-v1"||m.producer?.scriptSha256!=="e111c997be4c8c05ccd5c62a92f99f699b1e0713569e36a514ac6ef4f6635cca"||m.upstreamFileCount!==899||m.upstreamTreeSha256!=="707e9b48bc3f17adb274a2a70ce1ce726b2537becda3d26b6db22b629f292842"||m.licenseSha256!=="e0a867ff513ea7be2a0ddc339ac6a031e459a38668e077b8f0e649544062f9f2")process.exit(1)' "$manifest"
test "$(tar -xOf "$archive" pnpm/9.15.4/.corepack)" = '{"locator":{"name":"pnpm","reference":"9.15.4"},"bin":{"pnpm":"./bin/pnpm.cjs","pnpx":"./bin/pnpx.cjs"},"hash":"sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"}'
# All archive and manifest checks above must pass before extraction.
mkdir -p /usr/local/lib/pnpm-9.15.4
tar -xzf "$archive" -C /usr/local/lib/pnpm-9.15.4 --strip-components=2
rm -f /usr/local/lib/pnpm-9.15.4/.corepack
ln -sf /usr/local/lib/pnpm-9.15.4/bin/pnpm.cjs /usr/local/bin/pnpm
ln -sf /usr/local/lib/pnpm-9.15.4/bin/pnpx.cjs /usr/local/bin/pnpx
rm -rf /root/.cache/node/corepack
test "$(node --version)" = v26.9.0
test "$(pnpm --version)" = 9.15.4
touch /usr/local/share/braavo-offline-corepack
COREPACK

FROM ${COREPACK_BOOTSTRAP} AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/db/package.json ./packages/db/
COPY packages/core/package.json ./packages/core/
COPY packages/api/package.json ./packages/api/
COPY packages/memory/package.json ./packages/memory/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/connector-sdk/package.json ./packages/connector-sdk/
RUN --mount=type=cache,id=braavo-pnpm-9.15.4-40c3a48a43a7722fccbd017f7f8ea168be110562c1234643ce714c18f9a272d9,target=/pnpm/store,sharing=locked <<'INSTALL'
set -eu
pnpm config set store-dir /pnpm/store
if test -f /usr/local/share/braavo-offline-corepack; then
  pnpm install --offline --frozen-lockfile
else
  pnpm fetch --frozen-lockfile
  pnpm install --frozen-lockfile
fi
# This upstream test fixture is not runtime code. Remove it in the same install
# layer so no historical OCI/cache layer contains an unsupported nested ZIP.
find "/app/node_modules/.pnpm/thread-stream@3.1.0/node_modules/thread-stream/test" -type f -name '*.zip' -delete
INSTALL

# Build
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
# Per-package node_modules — Docker COPY does not glob-expand the
# destination, so `./packages/*/node_modules` was being treated as a
# literal path and the prisma binary never landed in
# `packages/db/node_modules/.bin`. Each workspace gets its own COPY
# (mirrors the pattern Dockerfile.ui already uses).
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=deps /app/packages/memory/node_modules ./packages/memory/node_modules
COPY --from=deps /app/packages/integrations/node_modules ./packages/integrations/node_modules
COPY --from=deps /app/packages/connector-sdk/node_modules ./packages/connector-sdk/node_modules
COPY . .
RUN --mount=type=cache,id=braavo-prisma-6.19.2-linux-musl-arm64,target=/root/.cache/prisma,sharing=locked \
    pnpm --filter @ai-company-os/db exec prisma generate
RUN pnpm --filter @ai-company-os/core build
RUN pnpm --filter @ai-company-os/memory build
RUN pnpm --filter @ai-company-os/integrations build
# connector-sdk before api — the API's tsc build imports its dist types.
RUN pnpm --filter @ai-company-os/connector-sdk build
RUN pnpm --filter @ai-company-os/api build

# Strip source maps from the runtime build. tsconfig.base.json keeps
# `sourceMap: true` for dev (DevTools/test-runner-friendly), but maps in
# the prod image leak the original TypeScript layout — including
# encryption.ts and sentry.ts logic — if the image is ever pulled from
# a leaked registry or a misconfigured CI artifact. ~30 .map files,
# ~200 KB total, no runtime cost to dropping them.
RUN find /app/packages/*/dist -name "*.map" -delete

# Production
FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app/packages/api/dist ./packages/api/dist
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/memory/dist ./packages/memory/dist
COPY --from=build /app/packages/integrations/dist ./packages/integrations/dist
COPY --from=build /app/packages/connector-sdk/dist ./packages/connector-sdk/dist
COPY --from=build /app/packages/db/prisma ./packages/db/prisma
COPY --from=build /app/node_modules ./node_modules
# Same per-package COPY as in the build stage — glob destination is
# not legal Docker syntax and was silently producing a directory
# literally named `*` in the runner image.
COPY --from=build /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=build /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=build /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=build /app/packages/memory/node_modules ./packages/memory/node_modules
COPY --from=build /app/packages/integrations/node_modules ./packages/integrations/node_modules
COPY --from=build /app/packages/connector-sdk/node_modules ./packages/connector-sdk/node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/packages/db/package.json ./packages/db/
COPY --from=build /app/packages/core/package.json ./packages/core/
COPY --from=build /app/packages/api/package.json ./packages/api/
COPY --from=build /app/packages/memory/package.json ./packages/memory/
COPY --from=build /app/packages/integrations/package.json ./packages/integrations/
COPY --from=build /app/packages/connector-sdk/package.json ./packages/connector-sdk/

# Normalize file permissions before dropping privileges. Cross-platform
# buildx builds on macOS hosts have produced files with mode 600 (only
# root-readable), which then EACCES the non-root runtime user. `a+rX`
# adds read-everywhere for files and traverse-everywhere for dirs —
# no exec bit gained on regular files.
RUN chmod -R a+rX /app

# Run as non-root user
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 aicos
USER aicos

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -q --spider http://localhost:8080/health || exit 1
CMD ["node", "packages/api/dist/index.js"]
