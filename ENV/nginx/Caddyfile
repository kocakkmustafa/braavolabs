# Braavolabs production Caddy config (alternative to nginx).
# Caddy auto-fetches Let's Encrypt certs on first start — no certbot needed.
#
# Run:  caddy run --config /etc/caddy/Caddyfile
# Reload: caddy reload --config /etc/caddy/Caddyfile

{
    # Email used for Let's Encrypt registration + expiry notifications.
    email founder@braavolabs.com
}

# Apex + www — marketing site
braavolabs.com, www.braavolabs.com {
    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://plausible.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://app.braavolabs.com"
        Cross-Origin-Resource-Policy same-origin
    }

    # Long-cache static Next.js assets
    @nextStatic path /_next/static/*
    handle @nextStatic {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy 127.0.0.1:3000 {
            header_down -Set-Cookie
            header_down -Access-Control-Allow-Origin
        }
    }

    # Public responses never forward an upstream cookie or CORS grant. Locale
    # preference remains a host-only client cookie; auth cookies stay on API.
    reverse_proxy 127.0.0.1:3000 {
        header_down -Set-Cookie
        header_down -Access-Control-Allow-Origin
    }
}

# api.braavolabs.com — Express API
api.braavolabs.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        Access-Control-Allow-Origin "https://app.braavolabs.com"
        Access-Control-Allow-Credentials "true"
        Vary Origin
    }

    # SSE run streaming — disable buffering, long timeout
    @sse path /api/v1/runs/*
    handle @sse {
        reverse_proxy 127.0.0.1:8080 {
            transport http {
                read_buffer 4KB
                write_buffer 4KB
            }
            flush_interval -1
        }
    }

    # Stripe webhook — pass raw body as-is
    @stripe path /hooks/stripe
    handle @stripe {
        reverse_proxy 127.0.0.1:8080 {
            request_buffers 0
        }
    }

    # Health endpoint — bypass log
    @health path /health
    handle @health {
        log_skip
        reverse_proxy 127.0.0.1:8080
    }

    reverse_proxy 127.0.0.1:8080
}

# app.braavolabs.com — authenticated dashboard
app.braavolabs.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com https://avatars.githubusercontent.com; connect-src 'self' https://api.braavolabs.com wss://api.braavolabs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Cross-Origin-Resource-Policy same-origin
    }

    @nextStatic path /_next/static/*
    handle @nextStatic {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy 127.0.0.1:3000
    }

    reverse_proxy 127.0.0.1:3000
}
