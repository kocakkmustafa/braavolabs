# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://aicos:aicos_dev@localhost:5432/aicos_dev?schema=public"
# For Docker Compose — set a strong password for production
POSTGRES_PASSWORD=aicos_dev

# ── Redis ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# For Docker Compose production — set a password for Redis
REDIS_PASSWORD=

# ── API ───────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ── Auth ──────────────────────────────────────────────
# IMPORTANT: Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-char-secret!!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# ── Claude / Anthropic ────────────────────────────────
# LLM_PROVIDER=local  → uses Claude Code CLI (no API key needed, requires `claude` in PATH)
# LLM_PROVIDER=api    → uses Anthropic API (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Voyage AI (Embeddings) ────────────────────────────
VOYAGE_API_KEY=

# ── HubSpot CRM ──────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ── Stripe Billing ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── App URL ──────────────────────────────────────────
APP_URL=http://localhost:3001

# ── Email (SendGrid) ─────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aicompanyos.com

# ── Social APIs ───────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── n8n ───────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=

# ── OpenTelemetry ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-company-os-api

# ── Encryption (AES-256-GCM — must be at least 32 chars, unique per deployment) ──
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-32-char-key!!!

# ── Billing Bypass (set true for testing, NEVER in production) ──
BYPASS_BILLING=false

# ── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="AI Company OS"
