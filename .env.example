# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://aicos:aicos_dev@localhost:5432/aicos_dev?schema=public"
# For Docker Compose — set a strong password for production
POSTGRES_PASSWORD=aicos_dev
# RLS-real STAGE 2 (prod only, gated). Set to a NON-superuser role's URL
# (e.g. aicos_app) to ACTIVATE Row-Level Security — the STAGE 1 per-query tenant
# binding only bites when the runtime role can't bypass RLS. Unset → the app
# uses the owner `aicos` (compose default) = RLS stays a no-op. Migrations always
# run as the owner (compose MIGRATE_DATABASE_URL). See RLS-STAGE2-RUNBOOK.md.
# RUNTIME_DATABASE_URL=postgresql://aicos_app:<pw>@postgres:5432/aicos_prod?schema=public&connection_limit=20&pool_timeout=15

# ── Redis ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# For Docker Compose production — set a password for Redis
REDIS_PASSWORD=

# ── API ───────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug
# Number of trusted reverse-proxy hops in front of the API (nginx/Cloudflare).
# Express `trust proxy` uses this to pick the real client IP for rate limits.
# SECURITY: set it to the EXACT number of proxies — too high lets clients
# spoof X-Forwarded-For and evade IP-keyed rate limits. Default 1; dev forces 0.
TRUST_PROXY_HOPS=1

# ── Auth ──────────────────────────────────────────────
# IMPORTANT: Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-char-secret!!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Web auth cookie mode (D-007/E9). "false" (default) = bearer-only, unchanged.
# "true" = login/register/refresh ALSO set httpOnly+Secure+SameSite=Strict
# access/refresh cookies and authMiddleware accepts the access cookie when no
# Authorization: Bearer header is present (bearer keeps priority). Cookie-authed
# state-changing requests require the X-Requested-With header (CSRF). The web UI
# is now cookie-mode-ready (see NEXT_PUBLIC_AUTH_COOKIE_MODE in Frontend). Flip
# BOTH together in prod + verify a live login (the cookie flow can't be tested
# headless); keep both off until that coordinated step.
AUTH_COOKIE_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# GitHub OAuth — get from https://github.com/settings/developers (New OAuth App).
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# ── Mobile OAuth (separate clients from web) ──────────
# Mobile uses its own OAuth clients because the redirect URIs differ
# (braavolabs:// scheme vs. https://braavolabs.com).
#
# Google: create iOS + Android OAuth client IDs at
#   https://console.cloud.google.com/apis/credentials
# Use bundle id com.braavolabs.mobile (iOS) and the same package name
# plus your release SHA-1 fingerprint (Android, from EAS Build).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# GitHub: create a SECOND OAuth App at
#   https://github.com/settings/developers
# Authorization callback URL: braavolabs://oauth/github/callback
GITHUB_MOBILE_CLIENT_ID=
GITHUB_MOBILE_CLIENT_SECRET=

# Apple Sign-In bundle identifier. Same as APPLE_BUNDLE_ID below; kept
# as a separate var so the IAP and SIWA paths can be configured
# independently if you ever ship two different iOS apps.
APPLE_SIWA_BUNDLE_ID=com.braavolabs.mobile

# Web Sign-In with Apple — separate Service ID (not an App ID).
# Create at developer.apple.com → Identifiers → Services IDs:
#   - Identifier:           com.braavolabs.signin
#   - Sign in with Apple:   enabled, link to primary App ID
#                           (com.braavolabs.mobile) so Apple `sub`
#                           is shared with the iOS app
#   - Return URLs:          https://api.braavolabs.com/api/v1/auth/apple/callback
APPLE_WEB_SERVICE_ID=
APPLE_WEB_REDIRECT_URI=http://localhost:8080/api/v1/auth/apple/callback

# ── Claude / Anthropic ────────────────────────────────
# LLM_PROVIDER=local  → uses Claude Code CLI (no API key needed, requires `claude` in PATH)
# LLM_PROVIDER=api    → uses Anthropic API (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Voyage AI (Embeddings) ────────────────────────────
VOYAGE_API_KEY=

# ── HubSpot CRM ──────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ── Stripe Billing ────────────────────────────────────
# Get these from Stripe Dashboard → Developers → API keys + Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs — create 4 products × 2 prices each in Stripe Dashboard
# Product names: Creator, Pro, Business, Enterprise
# Each product has 2 prices: monthly + yearly (yearly = monthly × 12 × 0.80)
STRIPE_CREATOR_PRICE_ID=
STRIPE_CREATOR_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# ── App URL ──────────────────────────────────────────
APP_URL=http://localhost:3001
# Public origin of the API itself (used for links in emails that hit API
# routes directly, e.g. one-click email verification). Leave empty to
# auto-derive: production → APP_URL (same-origin /api/v1 via nginx),
# dev → http://localhost:8080
API_PUBLIC_URL=

# ── Email (SendGrid) ─────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@braavolabs.com

# ── Social APIs ───────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── n8n ───────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=

# ── OpenTelemetry ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-company-os-api

# ── Encryption (AES-256-GCM, scrypt-derived key — unique per deployment) ──
# Production startup will REFUSE to boot if this contains a placeholder string.
# Generate a real key with:  openssl rand -hex 32
# Rotation: see docs/security/encryption-rotation.md (V1.1 plan).
ENCRYPTION_KEY=PLEASE_GENERATE_USING_openssl_rand_hex_32

# ── Billing Bypass (set true for testing, NEVER in production) ──
BYPASS_BILLING=false

# ── Sentry (error reporting — REQUIRED in production, optional in dev) ──
# Get DSN from sentry.io project settings. SDK no-ops when unset.
SENTRY_DSN=
# Optional: tag releases so error rates can be split per deploy.
SENTRY_RELEASE=
# Default 0.05 (5%) — bump to 1.0 to trace every request during incident triage.
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Backup off-site sync (REQUIRED in production) ──
# When all four are set, the postgres-backup service mirrors every nightly
# dump to the named S3 bucket. Without them, backups are local-only (NOT
# safe for production — disk loss = data loss).
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=aicos-prod/
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="Braavolabs"
# Cookie-mode web half. "true" → the auth store stops mirroring the access +
# refresh JWTs into localStorage and relies on the API's httpOnly cookies
# (credentials are already sent on every request). MUST be flipped together with
# the API's AUTH_COOKIE_MODE, and verified with a real login. Off = today's
# bearer-from-localStorage behavior.
NEXT_PUBLIC_AUTH_COOKIE_MODE=false
# When set, Plausible Analytics script loads on every page (privacy-first,
# no cookies, KVKK-compliant). Leave empty to omit entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Search engine verification (meta-tag fallback path) ──
# Each value is the raw token from the provider's verification page.
# DNS-TXT verification is preferred; meta tag is the fallback when DNS is
# managed off-platform. Empty = tag omitted.
#   Google Search Console:    https://search.google.com/search-console
#   Bing Webmaster Tools:     https://www.bing.com/webmasters
#   Yandex Webmaster:         https://webmaster.yandex.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── Trial LLM (Groq, free tier for non-subscribed users) ──
# Each new tenant gets `trialRunsLimit` pipeline runs routed through Groq
# (zero-cost to the user, fast inference) before they must BYOK or upgrade.
# The key here is HOLDING-OWNED — its usage rolls up to our Groq invoice,
# so cap aggressively. Leave blank to disable trial runs entirely.
#   Get the key:  https://console.groq.com/keys
GROQ_API_KEY=
# Groq model used for trial runs. llama-3.3-70b-versatile is the strongest
# free-tier option as of writing. Change here to swap it everywhere.
GROQ_TRIAL_MODEL=llama-3.3-70b-versatile

# ── Pipeline export DRM (offline license for downloaded pipelines) ──
# Independent secret from JWT_SECRET so we can rotate license tokens
# without invalidating user sessions. Generate with: openssl rand -hex 32
LICENSE_JWT_SECRET=
# Days a license token stays valid offline before requiring an online
# re-verify. 7 is a sensible default — long enough for users on flights /
# in air-gapped envs, short enough to limit blast radius if a key leaks.
LICENSE_TTL_DAYS=7
# Per-month allowance of machine-fingerprint changes. Stops password
# sharing while still allowing legitimate "I bought a new laptop" flows.
LICENSE_MACHINE_CHANGES_PER_MONTH=1

# ── Mobile In-App Purchase verification ──
# Apple App Store Server API (StoreKit 2 path):
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# PEM-formatted ES256 private key from App Store Connect (multi-line; use
# \n in compose env). The key TYPE matters: it must be an In-App Purchase
# key, generated at https://appstoreconnect.apple.com → Users and Access →
# Integrations → In-App Purchase. A general App Store Connect API key
# (Integrations → App Store Connect API) is a different key type and the
# App Store Server API rejects it with 401.
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.braavolabs.mobile
# Legacy /verifyReceipt fallback (older iOS builds, not StoreKit 2):
APPLE_SHARED_SECRET=
# Google Play Developer API:
GOOGLE_PLAY_PACKAGE_NAME=com.braavolabs.mobile
# Base64-encoded service account JSON (decoded + parsed at runtime).
# Generate at: Play Console → Setup → API access → Service account create
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Google Play RTDN Pub/Sub push authentication (REQUIRED in production for
# /billing/iap/google/notify — the endpoint rejects unauthenticated pushes
# when NODE_ENV=production). Configure the push subscription with an OIDC
# service-account token; set the audience you configured on the push
# subscription (typically the notify URL), and optionally pin the SA email.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SA_EMAIL=
# Optional unified path covering both stores (RevenueCat dashboard secret).
REVENUECAT_WEBHOOK_SECRET=
# Vapi voice webhook HMAC secret (verifies inbound Vapi callbacks).
VAPI_WEBHOOK_SECRET=

# ── Air-gap / offline mode ──
# When "true", services/ai-client.ts blocks every cloud LLM provider
# (Anthropic / OpenAI / Google / etc) and only allows local Ollama / LM
# Studio / Custom-localhost. Designed for self-hosted air-gapped
# deployments — operators pair this with `LICENSE_*` keys so downloaded
# pipelines + LLM calls both stay on the user's network.
OFFLINE_MODE=false

# ── Native tool-use kill-switch (multi-provider orchestration) ──
# Comma-separated allowlist of providers allowed to use NATIVE
# function-calling (OpenAI tools / Gemini functionDeclarations). Leave
# unset for the default (all non-Anthropic providers). Remove a provider
# from the list to instantly roll it back to prompt-embedded tools if its
# dialect misbehaves. ANTHROPIC is never gated.
#   Default: OPENAI,GROQ,MISTRAL,DEEPSEEK,KIMI,QWEN,OPENROUTER,GOOGLE,OLLAMA,LMSTUDIO,CUSTOM
# NATIVE_TOOLUSE_PROVIDERS=
