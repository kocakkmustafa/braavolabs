// ─── A/B TESTING ───────────────────────────────────────

model AbTest {
  id              String       @id @default(cuid())
  tenantId        String       @map("tenant_id")
  companyId       String       @map("company_id")
  agentId         String       @map("agent_id")
  name            String
  description     String?
  status          AbTestStatus @default(DRAFT)
  winnerVariantId String?      @map("winner_variant_id")
  startedAt       DateTime?    @map("started_at")
  endedAt         DateTime?    @map("ended_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent    Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  variants AbTestVariant[]

  @@index([tenantId])
  @@index([companyId])
  @@index([agentId])
  @@map("ab_tests")
}

model AbTestVariant {
  id        String   @id @default(cuid())
  testId    String   @map("test_id")
  name      String
  config    Json     // Agent config override (systemPrompt, model, temperature, etc.)
  weight    Int      @default(50) // Traffic allocation percentage
  createdAt DateTime @default(now()) @map("created_at")

  test    AbTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  metrics AbTestMetric[]

  @@index([testId])
  @@map("ab_test_variants")
}

model AbTestMetric {
  id        String   @id @default(cuid())
  variantId String   @map("variant_id")
  runId     String?  @map("run_id")
  metric    String
  value     Float
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  variant AbTestVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("ab_test_metrics")
}

enum AbTestStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}
