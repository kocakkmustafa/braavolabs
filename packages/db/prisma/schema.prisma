generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT & AUTH ──────────────────────────────────────

model Tenant {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  plan                 Plan     @default(FREE)
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  users              User[]
  companies          Company[]
  usageMeters        UsageMeter[]
  activityLog        ActivityLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  name         String?
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(MEMBER)
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([tenantId])
  @@map("users")
}

// ─── COMPANY & AGENTS ───────────────────────────────────

model Company {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  name        String
  slug        String
  description String?
  primitives  Primitive[]
  status      CompanyStatus @default(DRAFT)
  config      Json          @default("{}")  // JSONB — company-specific settings
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents             Agent[]
  pipelines          Pipeline[]
  memoryItems        MemoryItem[]
  contacts           Contact[]
  deals              Deal[]
  outreachSequences  OutreachSequence[]
  evalResults        EvalResult[]
  drafts             Draft[]
  integrations       Integration[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("companies")
}

model Agent {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  role        String   // e.g. "content_creator", "sales_agent"
  systemPrompt String  @map("system_prompt") @db.Text
  tools       Json     @default("[]")  // allowed tool definitions
  model       String   @default("claude-sonnet-4-20250514")
  maxTokens   Int      @default(4096) @map("max_tokens")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runSteps  RunStep[]

  @@index([companyId])
  @@map("agents")
}

// ─── PIPELINES & RUNS ───────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  trigger     PipelineTrigger @default(MANUAL)
  schedule    String?  // cron expression for SCHEDULED trigger
  steps       Json     @default("[]")  // pipeline step definitions
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    Run[]

  @@index([companyId])
  @@map("pipelines")
}

model Run {
  id          String    @id @default(cuid())
  pipelineId  String    @map("pipeline_id")
  status      RunStatus @default(PENDING)
  trigger     String    @default("manual") // what triggered this run
  input       Json      @default("{}")
  output      Json?
  error       String?   @db.Text
  costUsd     Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  budgetUsd   Decimal?  @map("budget_usd") @db.Decimal(10, 6)
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  pipeline  Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  steps     RunStep[]
  approvals Approval[]

  @@index([pipelineId])
  @@index([status])
  @@map("runs")
}

model RunStep {
  id          String        @id @default(cuid())
  runId       String        @map("run_id")
  agentId     String?       @map("agent_id")
  stepIndex   Int           @map("step_index")
  name        String
  status      RunStepStatus @default(PENDING)
  reasoning   String        @db.Text  // ZORUNLU — "neden bu kararı verdin"
  input       Json          @default("{}")
  output      Json?
  error       String?       @db.Text
  costUsd     Decimal?      @map("cost_usd") @db.Decimal(10, 6)
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  run       Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  toolCalls ToolCall[]

  @@index([runId])
  @@map("run_steps")
}

model ToolCall {
  id          String         @id @default(cuid())
  runStepId   String         @map("run_step_id")
  toolName    String         @map("tool_name")
  input       Json           @default("{}")
  output      Json?
  status      ToolCallStatus @default(PENDING)
  durationMs  Int?           @map("duration_ms")
  error       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  runStep RunStep @relation(fields: [runStepId], references: [id], onDelete: Cascade)

  @@index([runStepId])
  @@index([toolName])
  @@map("tool_calls")
}

// ─── APPROVALS ──────────────────────────────────────────

model Approval {
  id          String         @id @default(cuid())
  runId       String         @map("run_id")
  type        ApprovalType   @default(SPEND)
  status      ApprovalStatus @default(PENDING)
  description String         @db.Text
  amountUsd   Decimal?       @map("amount_usd") @db.Decimal(10, 2)
  metadata    Json           @default("{}")
  decidedBy   String?        @map("decided_by")
  decidedAt   DateTime?      @map("decided_at")
  expiresAt   DateTime?      @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  run     Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  user    User? @relation(fields: [decidedBy], references: [id])

  @@index([runId])
  @@index([status])
  @@map("approvals")
}

// ─── MEMORY ─────────────────────────────────────────────

model MemoryItem {
  id          String       @id @default(cuid())
  companyId   String       @map("company_id")
  type        MemoryType
  status      MemoryStatus @default(CANDIDATE)
  content     String       @db.Text
  metadata    Json         @default("{}")
  source      String?      // which run/step created this
  confidence  Float        @default(0.5)
  useCount    Int          @default(0) @map("use_count")
  lastUsedAt  DateTime?    @map("last_used_at")
  promotedAt  DateTime?    @map("promoted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  embedding  MemoryEmbedding?
  edgesFrom  MemoryEdge[]      @relation("edge_from")
  edgesTo    MemoryEdge[]      @relation("edge_to")

  @@index([companyId])
  @@index([type, status])
  @@map("memory_items")
}

model MemoryEmbedding {
  id           String @id @default(cuid())
  memoryItemId String @unique @map("memory_item_id")
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime @default(now()) @map("created_at")

  memoryItem MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  @@map("memory_embeddings")
}

model MemoryEdge {
  id         String   @id @default(cuid())
  fromId     String   @map("from_id")
  toId       String   @map("to_id")
  relation   String   // e.g. "supports", "contradicts", "derives_from"
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now()) @map("created_at")

  from MemoryItem @relation("edge_from", fields: [fromId], references: [id], onDelete: Cascade)
  to   MemoryItem @relation("edge_to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
  @@map("memory_edges")
}

// ─── CRM ────────────────────────────────────────────────

model Contact {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  email         String?
  name          String?
  phone         String?
  linkedinUrl   String?  @map("linkedin_url")
  hubspotId     String?  @unique @map("hubspot_id")
  tags          String[] @default([])
  properties    Json     @default("{}")
  lastContactAt DateTime? @map("last_contact_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals       Deal[]
  enrollments OutreachEnrollment[]

  @@index([companyId])
  @@index([email])
  @@map("contacts")
}

model Deal {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  contactId   String    @map("contact_id")
  hubspotId   String?   @unique @map("hubspot_id")
  title       String
  stage       String    @default("lead")
  amountUsd   Decimal?  @map("amount_usd") @db.Decimal(10, 2)
  currency    String    @default("USD")
  closedAt    DateTime? @map("closed_at")
  properties  Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@map("deals")
}

// ─── OUTREACH ───────────────────────────────────────────

model OutreachSequence {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  name        String
  channel     OutreachChannel
  steps       Json            @default("[]") // sequence step definitions
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollments OutreachEnrollment[]

  @@index([companyId])
  @@map("outreach_sequences")
}

model OutreachEnrollment {
  id             String           @id @default(cuid())
  sequenceId     String           @map("sequence_id")
  contactId      String           @map("contact_id")
  currentStep    Int              @default(0) @map("current_step")
  status         EnrollmentStatus @default(ACTIVE)
  lastSentAt     DateTime?        @map("last_sent_at")
  repliedAt      DateTime?        @map("replied_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")
  failCount      Int              @default(0) @map("fail_count") // spam koruması için
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  sequence OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([contactId])
  @@index([status])
  @@map("outreach_enrollments")
}

// ─── BILLING ────────────────────────────────────────────

model UsageMeter {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  metric      String   // e.g. "runs", "tool_calls", "tokens"
  value       Int      @default(0)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  stripeMeterId String? @map("stripe_meter_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId])
  @@map("usage_meters")
}

// ─── EVALS ──────────────────────────────────────────────

model EvalResult {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  suite       String   // e.g. "safety", "sales_quality", "content_quality"
  testName    String   @map("test_name")
  passed      Boolean
  score       Float?
  details     Json     @default("{}")
  runId       String?  @map("run_id")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([suite])
  @@map("eval_results")
}

// ─── AUDIT LOG ──────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actor      String   // userId or "system" or agentId
  action     String   // e.g. "company.create", "run.start", "approval.approve"
  resource   String   // e.g. "company", "run", "contact"
  resourceId String?  @map("resource_id")
  details    Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_log")
}

// ─── DRAFTS ─────────────────────────────────────────────

model Draft {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  type        DraftType
  title       String
  content     Json        // draft content (JSONB for flexibility)
  status      DraftStatus @default(PENDING)
  channel     String?     // target channel: "tiktok", "linkedin", etc.
  scheduledAt DateTime?   @map("scheduled_at")
  publishedAt DateTime?   @map("published_at")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("drafts")
}

// ─── REFERRALS ─────────────────────────────────────────

model Referral {
  id              String         @id @default(cuid())
  referrerTenantId String        @map("referrer_tenant_id")
  referralCode    String         @unique @map("referral_code")
  referredTenantId String?       @map("referred_tenant_id")
  status          ReferralStatus @default(PENDING)
  rewardType      String?        @map("reward_type") // e.g. "extra_runs", "plan_upgrade"
  rewardApplied   Boolean        @default(false) @map("reward_applied")
  createdAt       DateTime       @default(now()) @map("created_at")
  convertedAt     DateTime?      @map("converted_at")

  @@index([referrerTenantId])
  @@index([referralCode])
  @@map("referrals")
}

// ─── INTEGRATIONS ──────────────────────────────────────

model Integration {
  id           String              @id @default(cuid())
  companyId    String              @map("company_id")
  provider     IntegrationProvider
  status       IntegrationStatus   @default(PENDING)
  credentials  String              @db.Text  // AES-256-GCM encrypted JSON
  label        String?             // user-friendly label
  metadata     Json                @default("{}")
  lastTestedAt DateTime?           @map("last_tested_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("integrations")
}

// ─── ENUMS ──────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum CompanyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum Primitive {
  ACQUISITION
  SALES
  DELIVERY
  CONTENT
  OPERATIONS
  FINANCE
  ANALYTICS
  MEMORY
  GOVERNANCE
}

enum PipelineTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  EVENT
}

enum RunStatus {
  PENDING
  RUNNING
  PAUSED
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ToolCallStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ApprovalType {
  SPEND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum MemoryType {
  EPISODIC
  SEMANTIC
  PROCEDURAL
}

enum MemoryStatus {
  CANDIDATE
  APPROVED
  DEPRECATED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  TWITTER
  TIKTOK
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  UNSUBSCRIBED
  BOUNCED
}

enum DraftType {
  SOCIAL_POST
  EMAIL
  BLOG_POST
  AD_COPY
  VIDEO_SCRIPT
}

enum DraftStatus {
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

enum IntegrationProvider {
  TIKTOK
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  TWITTER
  OPENAI
  RUNWAY
  ELEVENLABS
  MIDJOURNEY
  FLUX
  PIKA
  HUBSPOT
  STRIPE
  SENDGRID
  SLACK
  DISCORD
  WHATSAPP
  GOOGLE_CALENDAR
  GOOGLE_DOCS
  GOOGLE_SHEETS
  NOTION
  AIRTABLE
  SHOPIFY
  WORDPRESS
  FACEBOOK
  MAILCHIMP
  INTERCOM
  ZENDESK
  CALENDLY
  GITHUB
  TRELLO
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  EXPIRED
}
