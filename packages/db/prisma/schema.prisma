generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT & AUTH ──────────────────────────────────────

model Tenant {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  plan                 Plan     @default(FREE)
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  // Trial LLM counter — incremented every time a pipeline run is routed
  // through the holding-owned Groq key. Once trialRunsUsed >= trialRunsLimit,
  // the executor blocks the run with a "trial exhausted, BYOK or upgrade"
  // error. Limit is per-tenant (not per-user) so multi-seat workspaces
  // don't accidentally multiply free runs.
  trialRunsUsed        Int      @default(0) @map("trial_runs_used")
  trialRunsLimit       Int      @default(3) @map("trial_runs_limit")
  // Monthly hard cap on LLM + integration spend. When set and the
  // current period's projected spend (extrapolated from the last 7
  // days) exceeds this number, the dashboard surfaces a red banner
  // and the runner blocks new spend-approval-required actions. NULL
  // means "no cap" (default).
  monthlyBudgetUsd     Decimal? @map("monthly_budget_usd") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  users              User[]
  companies          Company[]
  usageMeters        UsageMeter[]
  activityLog        ActivityLog[]
  aiConfig           UserAIConfig?
  abTests            AbTest[]
  pipelineLicenses   PipelineLicense[]
  mobileSubscriptions MobileSubscription[]
  oidcConnection     OidcConnection?

  @@map("tenants")
}

// ─── AI PROVIDER CONFIG ─────────────────────────────────

model UserAIConfig {
  id              String     @id @default(cuid())
  tenantId        String     @unique @map("tenant_id")
  provider        AIProvider @default(ANTHROPIC)
  model           String     @default("claude-sonnet-4-20250514")
  encryptedApiKey String?    @map("encrypted_api_key") @db.Text
  // Custom base URL — used by OLLAMA / LMSTUDIO / CUSTOM providers and
  // optionally by OPENAI for proxies (Azure, OpenRouter-via-OpenAI-shim,
  // LiteLLM, Together, etc). Default per-provider is hardcoded in
  // ai-client.ts; this column is the user override. Empty/NULL means
  // fall back to the provider's default base URL.
  baseUrl         String?    @map("base_url") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("user_ai_configs")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  name         String?
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(MEMBER)
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  githubId            String?   @unique @map("github_id")
  // OIDC `sub` claim from the tenant's configured IdP. Scoped per
  // tenant (the same `sub` from a different tenant's Entra namespace
  // doesn't collide thanks to the composite unique below).
  oidcSubject         String?   @map("oidc_subject")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals        Approval[]
  devices          Device[]
  notificationPref NotificationPref?

  @@index([tenantId])
  // Composite uniqueness: an oidcSubject is only meaningful within
  // its tenant's IdP, so the same subject coming from two different
  // tenants' Entra/Okta instances doesn't conflict.
  @@unique([tenantId, oidcSubject], map: "users_tenant_oidc_subject_unique")
  @@map("users")
}

// ─── PUSH NOTIFICATIONS ─────────────────────────────────
//
// Mobile companion app (Apps/Braavo) registers its Expo Push token here
// on login. The notify service fans out approval / risk / draft events
// to every device a user owns. Cascades on user delete so GDPR erasure
// cleanly takes the tokens with it.

model Device {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  pushToken  String   @unique @map("push_token")
  platform   String // "ios" | "android" | "web"
  deviceName String?  @map("device_name")
  osVersion  String?  @map("os_version")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ─── MOBILE IN-APP PURCHASE ENTITLEMENT ──────────────────
//
// One row per Apple/Google subscription receipt. Mobile app posts the
// receipt to /billing/iap/verify after a successful StoreKit /
// PlayBilling purchase; the API verifies with Apple App Store Server
// API or Google Play Developer API and writes a row here. The row's
// `expiresAt` is the source of truth for entitlement on web — at login
// the API reads the latest non-expired row, the legacy Stripe path, OR
// the trial counter to decide the active plan. Apple's renewal webhooks
// (App Store Server Notifications V2) and Google's RTDN feed the same
// table so renewals/cancellations stay current.
//
// `provider` distinguishes which API verified the receipt (mostly for
// debugging — Apple receipts can't be replayed against Google and vice
// versa). `originalTransactionId` is the durable identifier across
// renewal cycles for both ecosystems; we treat it as the natural key so
// a single subscription chain has a single row regardless of how many
// times Apple's `latest_receipt` mutates underneath it.
model MobileSubscription {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  provider              String // "apple" | "google" | "revenuecat"
  productId             String   @map("product_id")
  // Apple: original_transaction_id; Google: subscriptionId.
  // RevenueCat: app_user_id+entitlement composite to keep a single row.
  originalTransactionId String   @unique @map("original_transaction_id")
  // Latest verified receipt blob. Apple receipts are base64; Google
  // purchase tokens are short opaque strings. Stored encrypted at rest
  // — the verification path decrypts only on inbound webhook /
  // /verify calls. Treated as PII per Apple/Google ToS.
  latestReceipt         String?  @map("latest_receipt") @db.Text
  status                String // "active" | "in_grace_period" | "expired" | "revoked" | "paused"
  // Plan tier this subscription grants ("CREATOR" / "BUSINESS" / etc.).
  // Mirrors the Plan enum string — kept as String to allow new tiers
  // without a schema migration.
  planTier              String   @map("plan_tier")
  startedAt             DateTime @map("started_at")
  expiresAt             DateTime @map("expires_at")
  autoRenew             Boolean  @default(true) @map("auto_renew")
  // Last time we re-verified with Apple/Google. Renewal webhooks /
  // periodic re-verify cron updates this.
  lastVerifiedAt        DateTime @default(now()) @map("last_verified_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("mobile_subscriptions")
}

// Per-user push notification preferences. Stored on its own row (not
// per-device) because users want a single "alert me for approvals"
// switch, not separate switches per phone they own. Defaults match the
// mobile app's CHANNELS list — approvals + risks ON, runs + drafts OFF
// (signal vs. noise).
model NotificationPref {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  approvals Boolean  @default(true)
  risks     Boolean  @default(true)
  runs      Boolean  @default(false)
  drafts    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

// ─── PIPELINE EXPORT DRM ────────────────────────────────
//
// One license row per tenant — tracks which physical machine is currently
// bound to the tenant's downloaded pipeline files. The encrypted pipeline
// file ships with a JWT token (signed with LICENSE_JWT_SECRET, TTL =
// LICENSE_TTL_DAYS, default 7 days). The local runtime decrypts the
// pipeline only when the JWT matches the current machine's fingerprint.
//
// Why per-tenant (not per-user / per-pipeline)?
//   • Most users own all pipelines they download — per-user adds friction.
//   • Per-pipeline would balloon the table; we'd bind the same machine N
//     times for one user with N pipelines. Per-tenant is the natural unit.
//   • If we ever need per-pipeline scoping (e.g. enterprise hand-off), we
//     can add a `pipelineId String?` column without rewriting the model.
model PipelineLicense {
  id                              String   @id @default(cuid())
  tenantId                        String   @unique @map("tenant_id")
  // SHA-256 of machine attributes (CPU id + OS + hostname + MAC). Empty
  // until the first machine binds. SHA-256 is one-way so we never store
  // the underlying machine identifiers — only their fingerprint.
  deviceFingerprint               String?  @map("device_fingerprint")
  // When the current binding was set. Drives "license rebound on Apr 7"
  // copy in the dashboard.
  lastBoundAt                     DateTime? @map("last_bound_at")
  // Counter for monthly quota — incremented every time the bound machine
  // changes. Resets on the 1st of each calendar month (UTC) by the
  // change-machine handler when it sees a stale period.
  monthlyMachineChangesUsed       Int      @default(0) @map("monthly_machine_changes_used")
  // Period the counter belongs to ("YYYY-MM"). When the current month
  // doesn't match, the change handler zeroes the counter before checking
  // the quota — that way we don't need a cron job to reset.
  monthlyChangePeriod             String   @default("") @map("monthly_change_period")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pipeline_licenses")
}

// ─── COMPANY & AGENTS ───────────────────────────────────

model Company {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  name        String
  slug        String
  description String?
  primitives  Primitive[]
  status      CompanyStatus @default(DRAFT)
  config      Json          @default("{}")  // JSONB — company-specific settings
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents             Agent[]
  pipelines          Pipeline[]
  memoryItems        MemoryItem[]
  contacts           Contact[]
  deals              Deal[]
  outreachSequences  OutreachSequence[]
  evalResults        EvalResult[]
  drafts             Draft[]
  integrations       Integration[]
  abTests            AbTest[]
  voiceAgents        VoiceAgent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("companies")
}

model Agent {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  role        String   // e.g. "content_creator", "sales_agent"
  systemPrompt String  @map("system_prompt") @db.Text
  tools       Json     @default("[]")  // allowed tool definitions
  model       String   @default("claude-sonnet-4-20250514")
  maxTokens   Int      @default(4096) @map("max_tokens")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runSteps   RunStep[]
  abTests    AbTest[]
  versions   AgentVersion[]
  voiceAgent VoiceAgent?

  @@index([companyId])
  @@map("agents")
}

model AgentVersion {
  id            String   @id @default(cuid())
  agentId       String   @map("agent_id")
  version       Int      // Auto-incrementing version number per agent
  label         String?  // Optional label like "v2 - more concise"
  snapshot      Json     // Full agent config snapshot at this point
  changeSummary String?  @map("change_summary") @db.Text
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
  @@map("agent_versions")
}

// ─── PIPELINES & RUNS ───────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  trigger     PipelineTrigger @default(MANUAL)
  // Orchestration topology. SEQUENTIAL is the existing behaviour
  // (steps execute in array order). HIERARCHICAL adds a "manager"
  // agent at the top: it receives the run input, plans, then
  // delegates tasks to worker agents via the `delegate(agent_id, task)`
  // tool call. The runner consults `pipelineType` at dispatch time to
  // pick between executor paths.
  pipelineType PipelineType @default(SEQUENTIAL) @map("pipeline_type")
  // Manager agent for HIERARCHICAL pipelines. Required when
  // pipelineType=HIERARCHICAL, ignored otherwise.
  managerAgentId String? @map("manager_agent_id")
  // Max nested delegations per run (defence against an LLM that
  // delegates in a loop). Applied at runtime.
  maxDelegationDepth Int @default(3) @map("max_delegation_depth")
  schedule    String?  // cron expression for SCHEDULED trigger
  steps       Json     @default("[]")  // pipeline step definitions
  config      Json     @default("{}")  // trigger-specific config (webhookTemplate, etc.)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    Run[]

  @@index([companyId])
  @@map("pipelines")
}

enum PipelineType {
  SEQUENTIAL
  HIERARCHICAL
}

model Run {
  id          String    @id @default(cuid())
  pipelineId  String    @map("pipeline_id")
  status      RunStatus @default(PENDING)
  trigger     String    @default("manual") // what triggered this run
  input       Json      @default("{}")
  output      Json?
  error       String?   @db.Text
  costUsd     Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  budgetUsd   Decimal?  @map("budget_usd") @db.Decimal(10, 6)
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  pipeline  Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  steps     RunStep[]
  approvals Approval[]

  @@index([pipelineId])
  @@index([status])
  @@map("runs")
}

model RunStep {
  id          String        @id @default(cuid())
  runId       String        @map("run_id")
  agentId     String?       @map("agent_id")
  stepIndex   Int           @map("step_index")
  name        String
  status      RunStepStatus @default(PENDING)
  reasoning   String        @db.Text  // ZORUNLU — "neden bu kararı verdin"
  input       Json          @default("{}")
  output      Json?
  error       String?       @db.Text
  costUsd     Decimal?      @map("cost_usd") @db.Decimal(10, 6)
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  run       Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  toolCalls ToolCall[]

  @@index([runId])
  @@map("run_steps")
}

model ToolCall {
  id          String         @id @default(cuid())
  runStepId   String         @map("run_step_id")
  toolName    String         @map("tool_name")
  input       Json           @default("{}")
  output      Json?
  status      ToolCallStatus @default(PENDING)
  durationMs  Int?           @map("duration_ms")
  error       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  runStep RunStep @relation(fields: [runStepId], references: [id], onDelete: Cascade)

  @@index([runStepId])
  @@index([toolName])
  @@map("tool_calls")
}

// ─── APPROVALS ──────────────────────────────────────────

model Approval {
  id          String         @id @default(cuid())
  runId       String         @map("run_id")
  type        ApprovalType   @default(SPEND)
  status      ApprovalStatus @default(PENDING)
  description String         @db.Text
  amountUsd   Decimal?       @map("amount_usd") @db.Decimal(10, 2)
  metadata    Json           @default("{}")
  decidedBy   String?        @map("decided_by")
  decidedAt   DateTime?      @map("decided_at")
  expiresAt   DateTime?      @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  run     Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  user    User? @relation(fields: [decidedBy], references: [id])

  @@index([runId])
  @@index([status])
  @@map("approvals")
}

// ─── MEMORY ─────────────────────────────────────────────

model MemoryItem {
  id          String       @id @default(cuid())
  companyId   String       @map("company_id")
  type        MemoryType
  status      MemoryStatus @default(CANDIDATE)
  content     String       @db.Text
  metadata    Json         @default("{}")
  source      String?      // which run/step created this
  confidence  Float        @default(0.5)
  useCount    Int          @default(0) @map("use_count")
  lastUsedAt  DateTime?    @map("last_used_at")
  promotedAt  DateTime?    @map("promoted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  embedding  MemoryEmbedding?
  edgesFrom  MemoryEdge[]      @relation("edge_from")
  edgesTo    MemoryEdge[]      @relation("edge_to")

  @@index([companyId])
  @@index([type, status])
  @@map("memory_items")
}

model MemoryEmbedding {
  id           String @id @default(cuid())
  memoryItemId String @unique @map("memory_item_id")
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime @default(now()) @map("created_at")

  memoryItem MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  @@map("memory_embeddings")
}

model MemoryEdge {
  id         String   @id @default(cuid())
  fromId     String   @map("from_id")
  toId       String   @map("to_id")
  relation   String   // e.g. "supports", "contradicts", "derives_from"
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now()) @map("created_at")

  from MemoryItem @relation("edge_from", fields: [fromId], references: [id], onDelete: Cascade)
  to   MemoryItem @relation("edge_to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
  @@map("memory_edges")
}

// ─── CRM ────────────────────────────────────────────────

model Contact {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  email         String?
  name          String?
  phone         String?
  linkedinUrl   String?  @map("linkedin_url")
  hubspotId     String?  @unique @map("hubspot_id")
  tags          String[] @default([])
  properties    Json     @default("{}")
  lastContactAt DateTime? @map("last_contact_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals       Deal[]
  enrollments OutreachEnrollment[]

  @@index([companyId])
  @@index([email])
  @@map("contacts")
}

model Deal {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  contactId   String    @map("contact_id")
  hubspotId   String?   @unique @map("hubspot_id")
  title       String
  stage       String    @default("lead")
  amountUsd   Decimal?  @map("amount_usd") @db.Decimal(10, 2)
  currency    String    @default("USD")
  closedAt    DateTime? @map("closed_at")
  properties  Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@map("deals")
}

// ─── OUTREACH ───────────────────────────────────────────

model OutreachSequence {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  name        String
  channel     OutreachChannel
  steps       Json            @default("[]") // sequence step definitions
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollments OutreachEnrollment[]

  @@index([companyId])
  @@map("outreach_sequences")
}

model OutreachEnrollment {
  id             String           @id @default(cuid())
  sequenceId     String           @map("sequence_id")
  contactId      String           @map("contact_id")
  currentStep    Int              @default(0) @map("current_step")
  status         EnrollmentStatus @default(ACTIVE)
  lastSentAt     DateTime?        @map("last_sent_at")
  repliedAt      DateTime?        @map("replied_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")
  failCount      Int              @default(0) @map("fail_count") // spam koruması için
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  sequence OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([contactId])
  @@index([status])
  @@map("outreach_enrollments")
}

// ─── BILLING ────────────────────────────────────────────

model UsageMeter {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  metric      String   // e.g. "runs", "tool_calls", "tokens"
  value       Int      @default(0)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  stripeMeterId String? @map("stripe_meter_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId])
  @@map("usage_meters")
}

// ─── EVALS ──────────────────────────────────────────────

model EvalResult {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  suite       String   // e.g. "safety", "sales_quality", "content_quality"
  testName    String   @map("test_name")
  passed      Boolean
  score       Float?
  details     Json     @default("{}")
  runId       String?  @map("run_id")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([suite])
  @@map("eval_results")
}

// ─── VOICE AGENTS (Feature 6) ──────────────────────────
//
// Adds a "Voice" primitive on top of the existing 9 primitives. A
// VoiceAgent is a phone-reachable persona — one provisioned number
// per agent — that handles inbound calls (AI receptionist use
// case) and can place outbound calls when delegated to from
// another agent via the `make_outbound_call` tool.
//
// Provider is abstracted: VAPI / TWILIO_DEEPGRAM / RETELL / CUSTOM.
// Each provider has its own credentials in tenant integrations and
// its own webhook callback shape (handled in
// modules/voice/providers/<provider>.ts).

enum VoiceProvider {
  VAPI
  TWILIO_DEEPGRAM
  RETELL
  CUSTOM
}

enum VoiceCallDirection {
  INBOUND
  OUTBOUND
}

enum VoiceCallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

model VoiceAgent {
  id              String        @id @default(cuid())
  companyId       String        @map("company_id")
  agentId         String?       @unique @map("agent_id") // 1:1 mapping to the LLM agent that drives the conversation
  name            String
  phoneNumber     String?       @unique @map("phone_number") // E.164
  provider        VoiceProvider @default(VAPI)
  // Provider-specific config (system voice id, knowledge base id,
  // greeting prompt, hangup keywords). Schema is provider-shaped;
  // see modules/voice/providers/* for type guards.
  voiceConfig     Json          @default("{}") @map("voice_config")
  // Inbound-handling on/off. When false, the number returns a "this
  // line is not in service" prompt rather than reaching the agent.
  inboundEnabled  Boolean       @default(true) @map("inbound_enabled")
  // Outbound rate limit per hour. Defence against an LLM that
  // delegates a sales agent into a dialing loop. NULL = no cap.
  outboundPerHour Int?          @map("outbound_per_hour")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  calls   VoiceCall[]

  @@index([companyId])
  @@map("voice_agents")
}

model VoiceCall {
  id              String             @id @default(cuid())
  voiceAgentId    String             @map("voice_agent_id")
  // Cross-tenant defence: every voice call must be reachable from
  // a tenant via its company so the runner can scope by tenantId.
  tenantId        String             @map("tenant_id")
  direction       VoiceCallDirection
  callerNumber    String             @map("caller_number")
  calleeNumber    String             @map("callee_number")
  status          VoiceCallStatus    @default(RINGING)
  durationSeconds Int?               @map("duration_seconds")
  // Full transcript with timestamps + speaker labels. Bound size
  // (long calls are summarised by a post-call cron). NULL while a
  // call is in progress.
  transcript      Json?
  recordingUrl    String?            @map("recording_url")
  costUsd         Decimal?           @map("cost_usd") @db.Decimal(10, 4)
  // For outbound calls placed via the `make_outbound_call` tool,
  // this points at the run_step that initiated them — preserves
  // the audit trail "agent X delegated → voice call Y".
  initiatedByRunStepId String?       @map("initiated_by_run_step_id")
  // Provider's external id (Vapi call id, Twilio call SID, etc.).
  // Reused for de-dup when the same event fires through retries.
  providerCallId  String?            @unique @map("provider_call_id")
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  voiceAgent VoiceAgent @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade)

  @@index([voiceAgentId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("voice_calls")
}

// ─── ENTERPRISE SSO (OIDC) ─────────────────────────────
//
// Per-tenant generic OIDC connection. Works against Microsoft Entra
// (Azure AD), Okta, Google Workspace, Auth0, JumpCloud, any spec-
// compliant IdP. Plan-gated to BUSINESS+ at the router; the model
// itself just stores the config.
//
// `clientSecret` is AES-256-GCM encrypted at rest using the standard
// `encrypt()` helper with AAD = `tenantId|oidc_connection|client_secret`
// so a DB dump can't be lifted from one tenant to another.
//
// `domains` (string[]) lets the IdP's HD claim (Google) or `iss`-bound
// hosted-domain assertion (Entra) be cross-checked before granting
// access: an attacker holding a valid Microsoft token for some other
// org can't sign in as us if their domain isn't in our allowlist.

model OidcConnection {
  id                  String   @id @default(cuid())
  tenantId            String   @unique @map("tenant_id")
  issuer              String   // e.g. https://login.microsoftonline.com/{tenant}/v2.0
  clientId            String   @map("client_id")
  encryptedSecret     String   @map("encrypted_secret") @db.Text
  redirectUri         String   @map("redirect_uri")
  scopes              String   @default("openid email profile")
  // Comma-separated email-domain allowlist. Empty = no domain check.
  domains             String   @default("")
  // Discovery URL — when set, we fetch /.well-known/openid-configuration
  // here instead of constructing the auth+token URLs from `issuer`.
  discoveryUrl        String?  @map("discovery_url")
  // Cached endpoints. Populated on first auth attempt, refreshed
  // every 24h via the cron at module-init.
  authorizationEndpoint String? @map("authorization_endpoint")
  tokenEndpoint         String? @map("token_endpoint")
  jwksUri               String? @map("jwks_uri")
  discoveredAt          DateTime? @map("discovered_at")
  // When false, the connection is configured but not active — useful
  // for staging a swap (e.g. tenant migrating from Okta to Entra).
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("oidc_connections")
}

// ─── AUDIT LOG ──────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actor      String   // userId or "system" or agentId
  action     String   // e.g. "company.create", "run.start", "approval.approve"
  resource   String   // e.g. "company", "run", "contact"
  resourceId String?  @map("resource_id")
  details    Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The dashboard + per-resource activity timelines always filter by
  // tenantId and sort by createdAt DESC. At 10k DAU × ~50 actions/day
  // this table grows ~180M rows/year, at which point a single-column
  // (tenantId) index returns millions of rows that Postgres then has
  // to sort. The composite (tenantId, createdAt DESC) lets the planner
  // walk the btree in reverse and stop at LIMIT, turning a 5s query
  // into sub-100ms.
  // resourceId is the join key used by every per-company / per-run
  // timeline query (after the SEC-019 fix dropped the JSONB path-
  // equality fallback) — indexing it keeps the planner from sequential-
  // scanning activity_log under those queries.
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt])
  @@index([resourceId])
  @@map("activity_log")
}

// ─── DRAFTS ─────────────────────────────────────────────

model Draft {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  type        DraftType
  title       String
  content     Json        // draft content (JSONB for flexibility)
  status      DraftStatus @default(PENDING)
  channel     String?     // target channel: "tiktok", "linkedin", etc.
  scheduledAt DateTime?   @map("scheduled_at")
  publishedAt DateTime?   @map("published_at")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("drafts")
}

// ─── REFERRALS ─────────────────────────────────────────

model Referral {
  id              String         @id @default(cuid())
  referrerTenantId String        @map("referrer_tenant_id")
  referralCode    String         @unique @map("referral_code")
  referredTenantId String?       @map("referred_tenant_id")
  status          ReferralStatus @default(PENDING)
  rewardType      String?        @map("reward_type") // e.g. "extra_runs", "plan_upgrade"
  rewardApplied   Boolean        @default(false) @map("reward_applied")
  createdAt       DateTime       @default(now()) @map("created_at")
  convertedAt     DateTime?      @map("converted_at")

  @@index([referrerTenantId])
  @@index([referralCode])
  @@map("referrals")
}

// ─── INTEGRATIONS ──────────────────────────────────────

model Integration {
  id           String              @id @default(cuid())
  companyId    String              @map("company_id")
  provider     IntegrationProvider
  status       IntegrationStatus   @default(PENDING)
  credentials  String              @db.Text  // AES-256-GCM encrypted JSON
  label        String?             // user-friendly label
  metadata     Json                @default("{}")
  lastTestedAt DateTime?           @map("last_tested_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("integrations")
}

// Durable idempotency log for inbound Stripe webhook events.
//
// We previously had only a Redis SETNX guard with a 7-day TTL — fast
// (<1ms) but lossy: a Redis restart or eviction lets duplicate events
// reach the handler, which creates duplicate activity_log rows and
// (rarely) duplicate Hubspot/SendGrid side effects. This table is the
// durable backstop. The webhook handler does:
//
//   1. Try INSERT (unique constraint on stripeEventId).
//      → first-seen if it succeeds.
//      → duplicate if it raises P2002.
//   2. Process the event.
//   3. Update the row with `processedAt` + result summary.
//
// `processedAt` lets ops verify what's already been handled at a glance:
//   SELECT type, processedAt FROM stripe_events
//   WHERE created_at > NOW() - INTERVAL '24 hours' ORDER BY created_at DESC;
//
// Retention policy: keep 90 days, then drop. A simple SQL job can prune.
model StripeWebhookEvent {
  id              String    @id @default(cuid())
  stripeEventId   String    @unique @map("stripe_event_id")
  type            String                  // e.g. "checkout.session.completed"
  livemode        Boolean   @default(false)
  // Raw event payload. Kept verbose so we can audit edge cases later
  // (Stripe Connect, regional VAT events) without re-fetching from the
  // Stripe API. JSONB so it's queryable.
  rawPayload      Json      @map("raw_payload")
  // When we finished processing this event. NULL means we accepted it
  // but the handler didn't complete (most likely because we crashed
  // mid-handler — useful signal for ops).
  processedAt     DateTime? @map("processed_at")
  // Short summary of what the handler did, e.g.
  //   { tenantId, plan, action: "subscription.upgraded" }
  // Helpful for replay / debugging without re-reading the raw payload.
  resultSummary   Json?     @map("result_summary")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@map("stripe_webhook_events")
}

