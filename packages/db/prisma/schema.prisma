}

enum ApprovalType {
  SPEND
  // Agent requested human input mid-run (ask_user). Approval.description holds
  // the question; the operator's answer arrives as a SteeringMessage(INPUT)
  // which resolves this approval and resumes the run.
  INPUT
  // Agent requested control of a CONNECTED external automation (trigger / pause
  // / resume an n8n / Make / Zapier run). metadata carries {connectionId,
  // action, targetId}; on APPROVE the decide handler runs the action
  // (runControlAction) and feeds the outcome back as a SteeringMessage(INPUT)
  // so the run resumes with the result. This is the "gate" half of the
  // external-automation control plane — and it surfaces in the same approvals
  // queue the mobile app already renders, so phone approval needs no app code.
  EXTERNAL_CONTROL
  // Cross-model handoff proposal (E3 §2.5): the provider chain died with a
  // marked FAILOVER-class error and a viable alternative provider exists —
  // metadata carries {handoffId, suggestedProvider, suggestedModel}. APPROVE
  // claims the handoff (claim runs BEFORE the generic re-enqueue; claim
  // failure cancels the enqueue). REJECT leaves the run FAILED (the proposal
  // is rejected, not the run) and cancels the ledger row. Surfaces in the
  // same approvals queue the mobile app already renders — zero mobile code.
  HANDOFF
}

