// ─── PUBLIC BENCHMARK (Feature 10) ────────────────────
//
// Braavolabs Bench — fixed task suites graded across every supported
// LLM provider, results published at /bench. Devin shipped SWE-bench
// + made it the public proof that "our agent is best at code"; this
// is the same play for general-purpose agent quality.
//
// Suites are seeded statically (see modules/bench/suites/*.ts). Each
// run scores one suite × one provider × one model; results are
// public-read so anyone — including non-customers — can see the
// leaderboard.

enum BenchProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
  MISTRAL
  GROQ
  OPENROUTER
  DEEPSEEK
  KIMI
  QWEN
  OLLAMA
  LMSTUDIO
}

model BenchSuite {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @db.Text
  // Static task definitions. Shape per suite is fixed and lives in
  // code under modules/bench/suites/*.ts; this column is the
  // serialised payload used by the runner.
  tasks       Json
  // Maximum score per task (so percentage normalisation works
  // consistently across suites with different weighting).
  maxScorePerTask Int  @default(10) @map("max_score_per_task")
  // When false, the suite is dropped from the public leaderboard but
  // kept in the DB for archival comparisons.
  isPublic    Boolean @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  runs BenchRun[]

  @@map("bench_suites")
}

model BenchRun {
  id              String        @id @default(cuid())
  suiteId         String        @map("suite_id")
  provider        BenchProvider
  model           String
  // Raw per-task scores (array, indexed by task position).
  scoresByTask    Json          @map("scores_by_task")
  // Aggregated overall: 0..1 normalised score.
  scoreNormalised Float         @map("score_normalised")
  // Cost-of-run, in USD, summed across every task.
  costUsd         Decimal       @map("cost_usd") @db.Decimal(10, 4)
  // Wall-clock time in milliseconds for the whole suite run.
  durationMs      Int           @map("duration_ms")
  // Optional human-readable note from whoever kicked off the run
  // (e.g. "v1.2 prompt template", "post-system-prompt-tightening").
  notes           String?       @db.Text
  ranAt           DateTime      @default(now()) @map("ran_at")

  suite BenchSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([suiteId, scoreNormalised(sort: Desc)], map: "bench_runs_suite_id_score_idx")
  @@index([provider, model, ranAt(sort: Desc)])
  @@map("bench_runs")
}

// ─── COMPANY TEMPLATE MARKETPLACE (Feature 9) ─────────
//
// A CompanyTemplate is a freeze-dried Company: its Pipelines +
// Agents + memory seeds + integration shape, packed as JSON. Other
// tenants install a template to bootstrap a new Company with one
// click instead of building one from scratch. Defensive flywheel
// the existing 9-primitive frame is already well-positioned for.
//
// Pricing supports both free templates (vendor brand-building) and
// paid templates (revenue share with publisher, Stripe Connect
// follow-up). Ratings + install count drive catalog ranking.

enum TemplatePricing {
  FREE
  PAID
}

enum TemplateVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model CompanyTemplate {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  version           String             @default("1.0.0")
  vendor            String
  description       String             @db.Text
  iconUrl           String?            @map("icon_url")
  // Up to 5 screenshot URLs for the catalog hero. JSON array of
  // strings; not a relation table since rotation is rare and the
  // bound is small.
  screenshotUrls    Json               @default("[]") @map("screenshot_urls")
  // Serialised company snapshot. Shape:
  //   { primitives, agents: [{role, systemPrompt, model, tools}],
  //     pipelines: [{name, steps, trigger, …}], memorySeeds: [...] }
  snapshot          Json
  // What primitives this template touches — used to filter the
  // catalog (e.g. "show me all content+publishing templates").
  primitives        Json               @default("[]")
  pricing           TemplatePricing    @default(FREE)
  priceUsd          Decimal?           @map("price_usd") @db.Decimal(10, 2)
  visibility        TemplateVisibility @default(PRIVATE)
  isApproved        Boolean            @default(false) @map("is_approved")
  publisherTenantId String?            @map("publisher_tenant_id")
  // Catalog ranking signals.
  installCount      Int                @default(0) @map("install_count")
  ratingAvg         Float              @default(0) @map("rating_avg")
  ratingCount       Int                @default(0) @map("rating_count")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  ratings  TemplateRating[]
  installs TemplateInstall[]

  @@index([visibility, isApproved, installCount(sort: Desc)])
  @@map("company_templates")
}

model TemplateRating {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  tenantId   String   @map("tenant_id")
  rating     Int      // 1..5
  review     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  template CompanyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([templateId, tenantId], map: "template_ratings_template_id_tenant_id_unique")
  @@index([templateId])
  @@map("template_ratings")
}

model TemplateInstall {
  id                  String   @id @default(cuid())
  templateId          String   @map("template_id")
  tenantId            String   @map("tenant_id")
  installedCompanyId  String?  @map("installed_company_id")
  pricePaidUsd        Decimal? @map("price_paid_usd") @db.Decimal(10, 2)
  // Stripe payment intent id for PAID templates. Populated when
  // the purchase completes; NULL for FREE installs.
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  createdAt           DateTime @default(now()) @map("created_at")

  template CompanyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([templateId, tenantId, installedCompanyId], map: "template_installs_unique_per_company")
  @@index([tenantId])
  @@index([templateId])
  @@map("template_installs")
}

// ─── CONNECTOR MARKETPLACE (Feature 8) ────────────────
//
// Generic connector model that lets third-party developers (and the
// Braavolabs team) publish tool bundles to a public catalog. Each
// connector points at an MCP (Model Context Protocol) server URL —
// the runtime fetches the tool schema, exposes the tools to agents,
// and proxies invocations through. Network-effect moat: Zapier has
// 30k+ actions; this is how Braavolabs catches up without writing
// every adapter in-house.
//
// Three pillars:
//   1. Connector — catalog entry. Public after admin approval.
//   2. TenantConnector — per-tenant install with encrypted creds.
//   3. Tool registration is dynamic: on first use, the runtime
//      pulls the tool list from the connector's MCP server and
//      registers `mcp_{connectorSlug}_{toolName}` into the
//      registry.

enum ConnectorAuthMethod {
  NONE
  API_KEY
  OAUTH2
  BASIC
  CUSTOM
}

enum ConnectorVisibility {
  PUBLIC      // listed in marketplace, anyone can install
  UNLISTED    // direct-install-only via slug, not catalog-listed
  PRIVATE     // only the publishing tenant can see + install
}

model Connector {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  version         String              @default("1.0.0")
  vendor          String              // human-readable publisher name
  description     String              @db.Text
  iconUrl         String?             @map("icon_url")
  documentationUrl String?            @map("documentation_url")
  // The MCP server endpoint that hosts this connector's tools. The
  // runtime fetches `{mcpServerUrl}/manifest` for the tool list and
  // POSTs JSON-RPC requests to `{mcpServerUrl}/invoke`.
  mcpServerUrl    String              @map("mcp_server_url") @db.Text
  authMethod      ConnectorAuthMethod @default(NONE) @map("auth_method")
  // Schema for the credentials this connector accepts. Shape:
  //   { fields: [{ name, type, required, label, hint }] }
  // Rendered by the marketplace install dialog.
  authSchema      Json                @default("{}") @map("auth_schema")
  // Snapshot of tools at publish time. Used as a hint in the catalog
  // listing; the runtime re-fetches the live manifest on use.
  toolsManifest   Json                @default("[]") @map("tools_manifest")
  visibility      ConnectorVisibility @default(PRIVATE)
  // Moderation flag. Public catalog only surfaces approved entries.
  isApproved      Boolean             @default(false) @map("is_approved")
  // Tenants who can publish — initially the developing tenant,
  // later (post-approval) marketplace.
  publisherTenantId String?           @map("publisher_tenant_id")
  // Bookkeeping for the catalog ranking + leaderboard.
  installCount    Int                 @default(0) @map("install_count")
  // Optional cryptographic signature over the manifest. Lets the
  // marketplace verify a connector hasn't been tampered with
  // between publish-time and install-time.
  manifestSignature String?           @map("manifest_signature") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  installs TenantConnector[]

  @@index([visibility, isApproved])
  @@map("connectors")
}

model TenantConnector {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  connectorId  String   @map("connector_id")
  // AES-256-GCM-encrypted JSON: the credentials filled in via the
  // install dialog. AAD bound to tenantId + connectorId so cross-
  // tenant ciphertext lift fails authentication.
  encryptedCredentials String  @map("encrypted_credentials") @db.Text
  // Cached manifest at install time. Refreshed when the runtime
  // detects a version mismatch.
  cachedToolsManifest  Json    @default("[]") @map("cached_tools_manifest")
  cachedAt             DateTime? @map("cached_at")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  // Per-tenant install-time spend cap. Defence against a malicious
  // connector that loops on its own paid tools.
  spendCapUsd  Decimal? @map("spend_cap_usd") @db.Decimal(10, 2)
  spendUsd     Decimal  @default(0) @map("spend_usd") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, connectorId], map: "tenant_connectors_tenant_id_connector_id_unique")
  @@index([tenantId])
  @@map("tenant_connectors")
}

// ─── WEB RESEARCH (Feature 7) ──────────────────────────
//
// Autonomous deep-research primitive. Manus / Devin / Wide-Research
// pattern: agent submits a question, the service runs multiple
// search → fetch → distill loops, records every source it touched,
// and produces a structured findings JSON (claims + supporting
// citations) for downstream agents to consume.
//
// Pricing model: per-session cost is the sum of (search API spend +
// LLM tokens). Logged on Session.costUsd and aggregated into the
// run's costUsd if invoked from a pipeline.

enum WebResearchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model WebResearchSession {
  id              String              @id @default(cuid())
  tenantId        String              @map("tenant_id")
  companyId       String              @map("company_id")
  // The originating agent step (if invoked from a pipeline). NULL
  // for ad-hoc operator-initiated research from the dashboard.
  initiatedByRunStepId String?         @map("initiated_by_run_step_id")
  query           String              @db.Text
  // Manager prompt + budget knobs, captured at start time so a
  // policy change mid-research doesn't break ongoing sessions.
  maxRounds       Int                 @default(3) @map("max_rounds")
  maxSources      Int                 @default(20) @map("max_sources")
  maxCostUsd      Decimal             @default(1.00) @map("max_cost_usd") @db.Decimal(10, 4)
  status          WebResearchStatus   @default(PENDING)
  // Aggregated structured output. Shape:
  //   { summary: string, claims: Array<{ claim, citations: [sourceId] }> }
  findings        Json?
  costUsd         Decimal?            @map("cost_usd") @db.Decimal(10, 4)
  error           String?             @db.Text
  startedAt       DateTime?           @map("started_at")
  completedAt     DateTime?           @map("completed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  sources WebResearchSource[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("web_research_sessions")
}

model WebResearchSource {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  url         String   @db.Text
  title       String?  @db.Text
  // Readability-extracted main content (capped at ~50KB at the
  // service layer). Empty when the fetch failed.
  content     String   @default("") @db.Text
  contentHash String   @map("content_hash") // SHA-256 — de-dups across rounds
  // Relevance score 0..1 from the agent's last evaluation pass.
  relevance   Float    @default(0)
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  session WebResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, contentHash], map: "web_research_sources_session_content_hash_unique")
  @@index([sessionId])
  @@map("web_research_sources")
}

// ─── VOICE AGENTS (Feature 6) ──────────────────────────
//
// Adds a "Voice" primitive on top of the existing 9 primitives. A
// VoiceAgent is a phone-reachable persona — one provisioned number
// per agent — that handles inbound calls (AI receptionist use
// case) and can place outbound calls when delegated to from
// another agent via the `make_outbound_call` tool.
//
// Provider is abstracted: VAPI / TWILIO_DEEPGRAM / RETELL / CUSTOM.
// Each provider has its own credentials in tenant integrations and
// its own webhook callback shape (handled in
// modules/voice/providers/<provider>.ts).

enum VoiceProvider {
  VAPI
  TWILIO_DEEPGRAM
  RETELL
  CUSTOM
}

enum VoiceCallDirection {
  INBOUND
  OUTBOUND
}

enum VoiceCallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

model VoiceAgent {
  id              String        @id @default(cuid())
  companyId       String        @map("company_id")
  agentId         String?       @unique @map("agent_id") // 1:1 mapping to the LLM agent that drives the conversation
  name            String
  phoneNumber     String?       @unique @map("phone_number") // E.164
  provider        VoiceProvider @default(VAPI)
  // Provider-specific config (system voice id, knowledge base id,
  // greeting prompt, hangup keywords). Schema is provider-shaped;
  // see modules/voice/providers/* for type guards.
  voiceConfig     Json          @default("{}") @map("voice_config")
  // Inbound-handling on/off. When false, the number returns a "this
  // line is not in service" prompt rather than reaching the agent.
  inboundEnabled  Boolean       @default(true) @map("inbound_enabled")
  // Outbound rate limit per hour. Defence against an LLM that
  // delegates a sales agent into a dialing loop. NULL = no cap.
  outboundPerHour Int?          @map("outbound_per_hour")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent   Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  calls   VoiceCall[]

  @@index([companyId])
  @@map("voice_agents")
}

model VoiceCall {
  id              String             @id @default(cuid())
  voiceAgentId    String             @map("voice_agent_id")
  // Cross-tenant defence: every voice call must be reachable from
  // a tenant via its company so the runner can scope by tenantId.
  tenantId        String             @map("tenant_id")
  direction       VoiceCallDirection
  callerNumber    String             @map("caller_number")
  calleeNumber    String             @map("callee_number")
  status          VoiceCallStatus    @default(RINGING)
  durationSeconds Int?               @map("duration_seconds")
  // Full transcript with timestamps + speaker labels. Bound size
  // (long calls are summarised by a post-call cron). NULL while a
  // call is in progress.
  transcript      Json?
  recordingUrl    String?            @map("recording_url")
  costUsd         Decimal?           @map("cost_usd") @db.Decimal(10, 4)
  // For outbound calls placed via the `make_outbound_call` tool,
  // this points at the run_step that initiated them — preserves
  // the audit trail "agent X delegated → voice call Y".
  initiatedByRunStepId String?       @map("initiated_by_run_step_id")
  // Provider's external id (Vapi call id, Twilio call SID, etc.).
  // Reused for de-dup when the same event fires through retries.
  providerCallId  String?            @unique @map("provider_call_id")
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  voiceAgent VoiceAgent @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([voiceAgentId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("voice_calls")
}

// ─── ENTERPRISE SSO (OIDC) ─────────────────────────────
//
// Per-tenant generic OIDC connection. Works against Microsoft Entra
// (Azure AD), Okta, Google Workspace, Auth0, JumpCloud, any spec-
// compliant IdP. Plan-gated to BUSINESS+ at the router; the model
// itself just stores the config.
//
// `clientSecret` is AES-256-GCM encrypted at rest using the standard
// `encrypt()` helper with AAD = `tenantId|oidc_connection|client_secret`
// so a DB dump can't be lifted from one tenant to another.
//
// `domains` (string[]) lets the IdP's HD claim (Google) or `iss`-bound
// hosted-domain assertion (Entra) be cross-checked before granting
// access: an attacker holding a valid Microsoft token for some other
// org can't sign in as us if their domain isn't in our allowlist.

model OidcConnection {
  id                  String   @id @default(cuid())
  tenantId            String   @unique @map("tenant_id")
  issuer              String   // e.g. https://login.microsoftonline.com/{tenant}/v2.0
  clientId            String   @map("client_id")
  encryptedSecret     String   @map("encrypted_secret") @db.Text
  redirectUri         String   @map("redirect_uri")
  scopes              String   @default("openid email profile")
  // Comma-separated email-domain allowlist. Empty = no domain check.
  domains             String   @default("")
  // Discovery URL — when set, we fetch /.well-known/openid-configuration
  // here instead of constructing the auth+token URLs from `issuer`.
  discoveryUrl        String?  @map("discovery_url")
  // Cached endpoints. Populated on first auth attempt, refreshed
  // every 24h via the cron at module-init.
  authorizationEndpoint String? @map("authorization_endpoint")
  tokenEndpoint         String? @map("token_endpoint")
  jwksUri               String? @map("jwks_uri")
  discoveredAt          DateTime? @map("discovered_at")
  // When false, the connection is configured but not active — useful
  // for staging a swap (e.g. tenant migrating from Okta to Entra).
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("oidc_connections")
}

// ─── AUDIT LOG ──────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actor      String   // userId or "system" or agentId
  action     String   // e.g. "company.create", "run.start", "approval.approve"
  resource   String   // e.g. "company", "run", "contact"
  resourceId String?  @map("resource_id")
  details    Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The dashboard + per-resource activity timelines always filter by
  // tenantId and sort by createdAt DESC. At 10k DAU × ~50 actions/day
  // this table grows ~180M rows/year, at which point a single-column
  // (tenantId) index returns millions of rows that Postgres then has
  // to sort. The composite (tenantId, createdAt DESC) lets the planner
  // walk the btree in reverse and stop at LIMIT, turning a 5s query
  // into sub-100ms.
  // resourceId is the join key used by every per-company / per-run
  // timeline query (after the SEC-019 fix dropped the JSONB path-
  // equality fallback) — indexing it keeps the planner from sequential-
  // scanning activity_log under those queries.
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId], map: "activity_log_tenant_id_idx")
  @@index([action])
  @@index([createdAt])
  @@index([resourceId])
  @@map("activity_log")
}

// ─── DRAFTS ─────────────────────────────────────────────

model Draft {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  type        DraftType
  title       String
  content     Json        // draft content (JSONB for flexibility)
  status      DraftStatus @default(PENDING)
  channel     String?     // target channel: "tiktok", "linkedin", etc.
  scheduledAt DateTime?   @map("scheduled_at")
  publishedAt DateTime?   @map("published_at")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("drafts")
}

// ─── REFERRALS ─────────────────────────────────────────

model Referral {
  id              String         @id @default(cuid())
  referrerTenantId String        @map("referrer_tenant_id")
  referralCode    String         @unique @map("referral_code")
  referredTenantId String?       @map("referred_tenant_id")
  status          ReferralStatus @default(PENDING)
  rewardType      String?        @map("reward_type") // e.g. "extra_runs", "plan_upgrade"
  rewardApplied   Boolean        @default(false) @map("reward_applied")
  createdAt       DateTime       @default(now()) @map("created_at")
  convertedAt     DateTime?      @map("converted_at")

  @@index([referrerTenantId])
  @@index([referralCode])
  @@map("referrals")
}

// ─── INTEGRATIONS ──────────────────────────────────────

model Integration {
  id           String              @id @default(cuid())
  companyId    String              @map("company_id")
  provider     IntegrationProvider
  status       IntegrationStatus   @default(PENDING)
  credentials  String              @db.Text  // AES-256-GCM encrypted JSON
  label        String?             // user-friendly label
  metadata     Json                @default("{}")
  lastTestedAt DateTime?           @map("last_tested_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("integrations")
}

// Durable idempotency log for inbound Stripe webhook events.
//
// We previously had only a Redis SETNX guard with a 7-day TTL — fast
// (<1ms) but lossy: a Redis restart or eviction lets duplicate events
// reach the handler, which creates duplicate activity_log rows and
// (rarely) duplicate Hubspot/SendGrid side effects. This table is the
// durable backstop. The webhook handler does:
//
//   1. Try INSERT (unique constraint on stripeEventId).
//      → first-seen if it succeeds.
//      → duplicate if it raises P2002.
//   2. Process the event.
//   3. Update the row with `processedAt` + result summary.
//
// `processedAt` lets ops verify what's already been handled at a glance:
//   SELECT type, processedAt FROM stripe_events
//   WHERE created_at > NOW() - INTERVAL '24 hours' ORDER BY created_at DESC;
//
// Retention policy: keep 90 days, then drop. A simple SQL job can prune.
model StripeWebhookEvent {
  id              String    @id @default(cuid())
  stripeEventId   String    @unique @map("stripe_event_id")
  type            String                  // e.g. "checkout.session.completed"
  livemode        Boolean   @default(false)
  // Raw event payload. Kept verbose so we can audit edge cases later
  // (Stripe Connect, regional VAT events) without re-fetching from the
  // Stripe API. JSONB so it's queryable.
  rawPayload      Json      @map("raw_payload")
  // When we finished processing this event. NULL means we accepted it
  // but the handler didn't complete (most likely because we crashed
  // mid-handler — useful signal for ops).
  processedAt     DateTime? @map("processed_at") @db.Timestamp(6)
  // Short summary of what the handler did, e.g.
  //   { tenantId, plan, action: "subscription.upgraded" }
  // Helpful for replay / debugging without re-reading the raw payload.
  resultSummary   Json?     @map("result_summary")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([type])
  @@index([createdAt])
  @@map("stripe_webhook_events")
}

// Append-only entitlement event ledger (BR-P0-003) — the single source of
// truth Stripe, Apple and Google events all fold through. See
// packages/api/src/modules/billing/entitlement-reducer.ts for the pure
// fold/combine/resolve logic this table feeds; tenant.plan and
// MobileSubscription stay as read PROJECTIONS of that fold's result,
// written by the same code path that appends here — never written to
// directly by a webhook handler anymore. StripeWebhookEvent's own dedup
// is untouched (this is a new, normalized layer alongside it, not a
// replacement — Stripe's row still records the raw payload for audit;
// this table records the normalized fact the reducer needs).
model EntitlementEvent {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  /// "stripe" | "apple" | "google" — see EntitlementSource in the reducer.
  source   String
  // Groups events into one subscription's stream (a Stripe subscription
  // id, or an Apple/Google originalTransactionId) — the unit foldStream()
  // operates over. A tenant can have more than one concurrent stream
  // (e.g. a Stripe web sub AND a mobile IAP sub); combineStreams()
  // resolves those into the entitlement that actually governs the tenant.
  streamId String @map("stream_id")
  // Dedup key: the SOURCE's own event/notification id (Stripe event.id,
  // Apple notificationUUID, Google Pub/Sub messageId) — unique PER
  // SOURCE, so the same webhook delivered twice never appends twice.
  // Mirrors StripeWebhookEvent.stripeEventId's already-proven pattern.
  sourceEventId String @map("source_event_id")
  // The reducer's ordering key. Usually the SOURCE time (Stripe's `created`,
  // Apple/Google notification time); a Google replacement-chain event may
  // be raised 1 ms past its root's previous event under the ownership lock
  // so an old-token revoke cannot sort after a newer verified grant.
  sourceTimestamp DateTime @map("source_timestamp") @db.Timestamp(6)
  /// "purchase" | "renewal" | "cancel" | "grace" | "refund" | "revoke" | "restore"
  type      String
  // Matches MobileSubscription.planTier's own choice of String over the
  // Plan enum — a new catalog tier shouldn't need a migration here either.
  planTier  String?   @map("plan_tier")
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  autoRenew Boolean   @default(true) @map("auto_renew")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([source, sourceEventId])
  @@index([tenantId, streamId])
  @@map("entitlement_events")
}

// ─── EXTERNAL AUTOMATION MONITORING (Phase 3 — connect-and-watch) ──
//
// The connect-don't-rebuild pillar: a user points Braavolabs at their
// existing n8n / Make / Zapier instance, and a background poller pulls
// that platform's execution history into ExternalRun rows so the
// dashboard shows native + imported runs in one pane of glass. No
// incumbent offers a unified cross-platform run monitor.
//
// Credentials are AES-256-GCM encrypted at rest (AAD = tenantId|id) — the
// poller decrypts just-in-time, never logs the key. `cursor` carries the
// last-seen external execution id/timestamp for incremental polling.
model ExternalConnection {
  id                   String                   @id @default(cuid())
  tenantId             String                   @map("tenant_id")
  // Optional: scope mirrored runs to one company; null = tenant-wide.
  companyId            String?                  @map("company_id")
  platform             ExternalPlatform
  label                String
  baseUrl              String                   @map("base_url") @db.Text
  encryptedCredentials String                   @map("encrypted_credentials") @db.Text
  pollIntervalSec      Int                      @default(60) @map("poll_interval_sec")
  enabled              Boolean                  @default(true)
  status               ExternalConnectionStatus @default(PENDING)
  lastPolledAt         DateTime?                @map("last_polled_at")
  lastError            String?                  @map("last_error") @db.Text
  // Incremental poll cursor (last external execution id / ISO timestamp).
  cursor               String?                  @db.Text
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalRuns ExternalRun[]

  @@index([tenantId])
  @@index([enabled, status])
  @@map("external_connections")
}

// One row per external execution observed on the connected platform. The
// (connectionId, externalId) pair is the natural key for idempotent upsert
// across poll cycles. `status` is normalised to our RunStatus vocabulary by
// the per-platform adapter; `raw` keeps a bounded snapshot for the detail view.
model ExternalRun {
  id           String    @id @default(cuid())
  connectionId String    @map("connection_id")
  externalId   String    @map("external_id")
  workflowName String?   @map("workflow_name")
  status       String
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  raw          Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  connection ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, startedAt(sort: Desc)])
  @@map("external_runs")
}

enum ExternalPlatform {
  N8N
  MAKE
  ZAPIER
  GENERIC
}

enum ExternalConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

