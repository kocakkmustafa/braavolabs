generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT & AUTH ──────────────────────────────────────

model Tenant {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  plan                 Plan     @default(MANUAL_REVIEW)
  // One-release compatibility snapshot retained by the additive
  // subscription-only migration. Never used as a new-sale entitlement.
  legacyPlan           String?  @map("legacy_plan")
  subscriptionMigrationState String @default("pending") @map("subscription_migration_state")
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  // Trial LLM counter — incremented every time a pipeline run is routed
  // through the holding-owned Groq key. Once trialRunsUsed >= trialRunsLimit,
  // the executor blocks the run with a "trial exhausted, BYOK or upgrade"
  // error. Limit is per-tenant (not per-user) so multi-seat workspaces
  // don't accidentally multiply free runs.
  trialRunsUsed        Int      @default(0) @map("trial_runs_used")
  trialRunsLimit       Int      @default(3) @map("trial_runs_limit")
  // Monthly hard cap on LLM + integration spend. When set and the
  // current period's projected spend (extrapolated from the last 7
  // days) exceeds this number, the dashboard surfaces a red banner
  // and the runner blocks new spend-approval-required actions. NULL
  // means "no cap" (default).
  monthlyBudgetUsd     Decimal? @map("monthly_budget_usd") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  users               User[]
  companies           Company[]
  usageMeters         UsageMeter[]
  activityLog         ActivityLog[]
  // Multi-key BYOK (E2/T6): one row per (tenant, provider) — the old
  // singular `aiConfig` relation became 1-N. The active config is the
  // row with isDefault=true; the rest form the failover chain (T7).
  aiConfigs           UserAIConfig[]
  abTests             AbTest[]
  pipelineLicenses    PipelineLicense[]
  mobileSubscriptions MobileSubscription[]
  googlePurchaseAliases GooglePurchaseAlias[]
  entitlementEvents   EntitlementEvent[]
  oidcConnection      OidcConnection?
  externalConnections ExternalConnection[]
  mediaAssets         MediaAsset[]
  handoffs            HandoffLedger[]
  // Media orchestration (FAZ E) — BYOK provider keys + generation ledger.
  mediaProviderKeys   MediaProviderKey[]
  mediaGenerations    MediaGeneration[]

  @@map("tenants")
}

// ─── AI PROVIDER CONFIG ─────────────────────────────────

model UserAIConfig {
  id                  String     @id @default(cuid())
  tenantId            String     @map("tenant_id")
  provider            AIProvider @default(ANTHROPIC)
  model               String     @default("claude-sonnet-4-20250514")
  encryptedApiKey     String?    @map("encrypted_api_key") @db.Text
  // Custom base URL — used by OLLAMA / LMSTUDIO / CUSTOM providers and
  // optionally by OPENAI for proxies (Azure, OpenRouter-via-OpenAI-shim,
  // LiteLLM, Together, etc). Default per-provider is hardcoded in
  // ai-client.ts; this column is the user override. Empty/NULL means
  // fall back to the provider's default base URL.
  baseUrl             String?    @map("base_url") @db.Text
  // Multi-key BYOK (E2/T6, plan §2.3): a tenant keeps one row PER PROVIDER
  // (composite unique below replaces the old tenantId @unique). Exactly one
  // row per tenant should carry isDefault=true — that row is the config
  // getTenantAIConfig resolves to. Enforced at the DB level by a partial
  // unique index in the migration (Prisma can't express partial indexes)
  // and at the app level by saveTenantAIConfig's demote-then-promote
  // transaction.
  isDefault           Boolean    @default(false) @map("is_default")
  // Position in the tenant's cross-provider failover chain (T7). NULL =
  // not part of the chain; lower = tried earlier. The default row is
  // always the chain head regardless of this value.
  fallbackOrder       Int?       @map("fallback_order")
  // Opt-in escape hatch (plan §2.2 / A8): when the tenant's own provider
  // chain is exhausted, may the run fall back to trial-Groq / system
  // Anthropic? Default false — sending tenant data to a provider the
  // tenant did not configure would break the BYOK trust contract.
  // Evaluated from the tenant's DEFAULT row (isDefault=true).
  allowSystemFallback Boolean    @default(false) @map("allow_system_fallback")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("user_ai_configs")
}

// ─── MEDIA ASSETS (E2/T9) ───────────────────────────────
//
// Binary outputs produced by agent media tools (text_to_speech audio,
// downloaded video stills, …). Stored as BYTEA with a hard 10MB cap
// enforced at write time (1.9GB Lightsail host — full body fits in RAM,
// no streaming needed). Served via GET /api/v1/media/:id with auth +
// tenant scoping. tenantId is derived from the owning company at write
// time (registry handlers only carry companyId — plan T9/A8).
//
// Retention: expiresAt defaults to now()+30 days at the DB level; an
// hourly sweep piggybacked on the approval-expiry cron deletes expired
// rows so unbounded BYTEA growth can't fill the small host disk.

model MediaAsset {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  companyId  String   @map("company_id")
  // Loose reference to the producing tool call (no FK — tool_calls
  // cascade away with their run step; the media may outlive the run).
  toolCallId String?  @map("tool_call_id")
  mime       String
  sizeBytes  Int      @map("size_bytes")
  bytes      Bytes
  expiresAt  DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)")) @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@map("media_assets")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  name         String?
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(MEMBER)
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  githubId            String?   @unique @map("github_id")
  // Apple Sign-In stable `sub` claim. Apple guarantees this is unique
  // per user-app pair and never changes (unlike the email, which the
  // user can hide via Apple's private relay). Pinned by unique index
  // so two users can't claim the same Apple identity.
  appleId             String?   @unique @map("apple_id")
  // Email verification — soft gate. When null, login still works but
  // a banner nags the user + free-tier abuse vectors are restricted.
  // OAuth flows (Apple/Google/GitHub) set this to now() at sign-in
  // because the provider has already verified the address.
  emailVerifiedAt           DateTime? @map("email_verified_at")
  // Apple 5.1.2(i): explicit, revocable consent before personal data is
  // sent to third-party AI providers. Null = not yet decided/revoked.
  aiConsentAt               DateTime? @map("ai_consent_at")
  emailVerifyTokenHash      String?   @map("email_verify_token_hash")
  emailVerifyTokenExpiresAt DateTime? @map("email_verify_token_expires_at")
  // OIDC `sub` claim from the tenant's configured IdP. Scoped per
  // tenant (the same `sub` from a different tenant's Entra namespace
  // doesn't collide thanks to the composite unique below).
  oidcSubject         String?   @map("oidc_subject")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals        Approval[]
  devices          Device[]
  notificationPref NotificationPref?

  @@index([tenantId])
  // Composite uniqueness: an oidcSubject is only meaningful within
  // its tenant's IdP, so the same subject coming from two different
  // tenants' Entra/Okta instances doesn't conflict. Enforced by the
  // PARTIAL unique index "users_tenant_oidc_subject_unique" (WHERE
  // oidc_subject IS NOT NULL) in migration 20260512_oidc_connections;
  // Prisma cannot model partial indexes, so it is not declared here.
  @@map("users")
  pushSessions PushSession[]
}

// ─── PUSH NOTIFICATIONS ─────────────────────────────────
//
// Mobile companion app (Apps/Braavo) registers its Expo Push token here
// on login. The notify service fans out approval / risk / draft events
// to every device a user owns. Cascades on user delete so GDPR erasure
// cleanly takes the tokens with it.

model Device {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  pushToken  String   @map("push_token")
  platform   String // "ios" | "android" | "web"
  deviceName String?  @map("device_name")
  osVersion  String?  @map("os_version")
  locale     String   @default("en")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pushSessionId String? @map("push_session_id")
  pushRevision Int? @map("push_revision")
  pushTokenHash String? @map("push_token_hash")
  pushPayloadHash String? @map("push_payload_hash")
  pushSession PushSession? @relation(fields: [pushSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pushTokenHash, pushSessionId])
  @@index([pushSessionId])
  @@index([userId])
  @@map("devices")
}

// Server-created login lineage. Missing/expired rows NEVER regain push authority
// through refresh or registration. Ordinary JWT authentication remains separate.
model PushSession {
  id String @id
  userId String @map("user_id")
  tenantId String @map("tenant_id")
  loginOrder BigInt @unique @default(autoincrement()) @map("login_order")
  revision Int @default(0)
  tokenHash String? @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  devices Device[]
  @@index([userId, tenantId])
  @@index([expiresAt])
  @@map("push_sessions")
}

// Cross-tenant coordination only: no raw token, user/tenant or message content.
// GC requires that no live older PushSession can acquire this token again.
model PushTokenFence {
  tokenHash String @id @map("token_hash")
  loginOrder BigInt @default(0) @map("login_order")
  sessionId String? @map("session_id")
  revision Int @default(0)
  @@map("push_token_fences")
}

// ─── MOBILE IN-APP PURCHASE ENTITLEMENT ──────────────────
//
// One row per Apple/Google subscription receipt. Mobile app posts the
// receipt to /billing/iap/verify after a successful StoreKit /
// PlayBilling purchase; the API verifies with Apple App Store Server
// API or Google Play Developer API and writes a row here. The row's
// `expiresAt` is the source of truth for entitlement on web — at login
// the API reads the latest non-expired row, the legacy Stripe path, OR
// the trial counter to decide the active plan. Apple's renewal webhooks
// (App Store Server Notifications V2) and Google's RTDN feed the same
// table so renewals/cancellations stay current.
//
// `provider` distinguishes which API verified the receipt (mostly for
// debugging — Apple receipts can't be replayed against Google and vice
// versa). `originalTransactionId` is the durable identifier across
// renewal cycles for both ecosystems; we treat it as the natural key so
// a single subscription chain has a single row regardless of how many
// times Apple's `latest_receipt` mutates underneath it.
model MobileSubscription {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  provider              String // "apple" | "google" | "revenuecat"
  productId             String   @map("product_id")
  // Apple: original_transaction_id; Google: subscriptionId.
  // RevenueCat: app_user_id+entitlement composite to keep a single row.
  originalTransactionId String   @unique @map("original_transaction_id")
  // Deprecated compatibility column. New writes are always NULL: Apple
  // receipts and Google purchase tokens are verification credentials and
  // must not be persisted. Durable reconciliation uses provider identity
  // plus the append-only entitlement event ledger instead.
  latestReceipt         String?  @map("latest_receipt") @db.Text
  status                String // "active" | "in_grace_period" | "expired" | "revoked" | "paused"
  // Plan tier this subscription grants ("CREATOR" / "BUSINESS" / etc.).
  // Mirrors the Plan enum string — kept as String to allow new tiers
  // without a schema migration.
  planTier              String   @map("plan_tier")
  startedAt             DateTime @map("started_at")
  expiresAt             DateTime @map("expires_at")
  autoRenew             Boolean  @default(true) @map("auto_renew")
  // Last time we re-verified with Apple/Google. Renewal webhooks /
  // periodic re-verify cron updates this.
  lastVerifiedAt        DateTime @default(now()) @map("last_verified_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googlePurchaseAliases GooglePurchaseAlias[]

  @@unique([id, tenantId, provider, originalTransactionId], map: "mobile_subscriptions_alias_owner_key")
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("mobile_subscriptions")
}

// Digest-only ownership aliases for Google Play replacement chains. Active
// rows bind one globally unique token digest to one tenant/subscription/root.
// `legacy_blocked` rows deliberately carry no owner: they prevent historical
// raw identities from being silently claimed before a separate reconciliation.
model GooglePurchaseAlias {
  tokenDigest              String   @id @map("token_digest")
  // Ownership never establishes ordering; legacy records remain unknown.
  lineageState             String   @default("unknown") @map("lineage_state")
  lineagePredecessorDigest  String?  @map("lineage_predecessor_digest")
  lineageVerifiedAt         DateTime? @map("lineage_verified_at")
  lineageEvidenceSource     String?  @map("lineage_evidence_source")
  state                    String   @default("active")
  tenantId                 String?  @map("tenant_id")
  mobileSubscriptionId     String?  @map("mobile_subscription_id")
  provider                 String?
  canonicalRootIdentity    String?  @map("canonical_root_identity")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription MobileSubscription? @relation(fields: [mobileSubscriptionId, tenantId, provider, canonicalRootIdentity], references: [id, tenantId, provider, originalTransactionId], onDelete: Cascade, map: "google_purchase_aliases_subscription_owner_fkey")

  @@index([tenantId])
  @@index([mobileSubscriptionId])
  @@index([canonicalRootIdentity])
  @@map("google_purchase_aliases")
}

// Redacted delivery admission/DLQ ledger for Apple ASN and Google RTDN.
// Raw signedPayload/JWS/purchaseToken/OIDC/secret material is forbidden here;
// fingerprint is a one-way digest used only to detect identity collisions.
model IapWebhookDelivery {
  id                  String    @id @default(cuid())
  provider            String
  deliveryId          String    @map("delivery_id")
  fingerprint         String
  status              String
  attempts            Int       @default(1)
  failureCode         String?   @map("failure_code")
  processingStartedAt DateTime? @map("processing_started_at")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([provider, deliveryId])
  @@index([status, updatedAt])
  @@map("iap_webhook_deliveries")
}

// Per-user push notification preferences. Stored on its own row (not
// per-device) because users want a single "alert me for approvals"
// switch, not separate switches per phone they own. Defaults match the
// mobile app's CHANNELS list — approvals + risks ON, runs + drafts OFF
// (signal vs. noise).
model NotificationPref {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  approvals Boolean  @default(true)
  risks     Boolean  @default(true)
  runs      Boolean  @default(false)
  drafts    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

// ─── PIPELINE EXPORT DRM ────────────────────────────────
//
// One license row per tenant — tracks which physical machine is currently
// bound to the tenant's downloaded pipeline files. The encrypted pipeline
// file ships with a JWT token (signed with LICENSE_JWT_SECRET, TTL =
// LICENSE_TTL_DAYS, default 7 days). The local runtime decrypts the
// pipeline only when the JWT matches the current machine's fingerprint.
//
// Why per-tenant (not per-user / per-pipeline)?
//   • Most users own all pipelines they download — per-user adds friction.
//   • Per-pipeline would balloon the table; we'd bind the same machine N
//     times for one user with N pipelines. Per-tenant is the natural unit.
//   • If we ever need per-pipeline scoping (e.g. enterprise hand-off), we
//     can add a `pipelineId String?` column without rewriting the model.
model PipelineLicense {
  id                              String   @id @default(cuid())
  tenantId                        String   @unique @map("tenant_id")
  // SHA-256 of machine attributes (CPU id + OS + hostname + MAC). Empty
  // until the first machine binds. SHA-256 is one-way so we never store
  // the underlying machine identifiers — only their fingerprint.
  deviceFingerprint               String?  @map("device_fingerprint")
  // When the current binding was set. Drives "license rebound on Apr 7"
  // copy in the dashboard.
  lastBoundAt                     DateTime? @map("last_bound_at")
  // Counter for monthly quota — incremented every time the bound machine
  // changes. Resets on the 1st of each calendar month (UTC) by the
  // change-machine handler when it sees a stale period.
  monthlyMachineChangesUsed       Int      @default(0) @map("monthly_machine_changes_used")
  // Period the counter belongs to ("YYYY-MM"). When the current month
  // doesn't match, the change handler zeroes the counter before checking
  // the quota — that way we don't need a cron job to reset.
  monthlyChangePeriod             String   @default("") @map("monthly_change_period")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pipeline_licenses")
}

// ─── COMPANY & AGENTS ───────────────────────────────────

model Company {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  name        String
  slug        String
  description String?
  primitives  Primitive[]
  status      CompanyStatus @default(DRAFT)
  config      Json          @default("{}")  // JSONB — company-specific settings
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents             Agent[]
  pipelines          Pipeline[]
  memoryItems        MemoryItem[]
  contacts           Contact[]
  deals              Deal[]
  outreachSequences  OutreachSequence[]
  evalResults        EvalResult[]
  drafts             Draft[]
  integrations       Integration[]
  abTests            AbTest[]
  voiceAgents        VoiceAgent[]
  mediaAssets        MediaAsset[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("companies")
}

model Agent {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  role        String   // e.g. "content_creator", "sales_agent"
  systemPrompt String  @map("system_prompt") @db.Text
  tools       Json     @default("[]")  // allowed tool definitions
  model       String   @default("claude-sonnet-4-20250514")
  maxTokens   Int      @default(4096) @map("max_tokens")
  // Graduated autonomy (Feature D6 — Relevance's signature). Controls how eager
  // this agent is to pause for human approval on NON-money tool calls:
  //   SUPERVISED — pause on every side-effecting/spend action.
  //   BALANCED   — pause on spend + tools flagged risky (high/medium risk).
  //                Default: preserves the historical behaviour, where only
  //                requiresApproval tools (spend + risky actions) paused.
  //   AUTONOMOUS — only the five risk-stops gate it; no routine approval pauses.
  // Money-touching actions ALWAYS require approval regardless of this setting
  // (CLAUDE.md rule #3 is inviolable) — autonomy only relaxes non-money pauses.
  autonomy    AgentAutonomy @default(BALANCED)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runSteps   RunStep[]
  abTests    AbTest[]
  versions   AgentVersion[]
  voiceAgent VoiceAgent?

  @@index([companyId])
  @@map("agents")
}

model AgentVersion {
  id            String   @id @default(cuid())
  agentId       String   @map("agent_id")
  version       Int      // Auto-incrementing version number per agent
  label         String?  // Optional label like "v2 - more concise"
  snapshot      Json     // Full agent config snapshot at this point
  changeSummary String?  @map("change_summary") @db.Text
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
  @@map("agent_versions")
}

// ─── PIPELINES & RUNS ───────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  trigger     PipelineTrigger @default(MANUAL)
  // Orchestration topology. SEQUENTIAL is the existing behaviour
  // (steps execute in array order). HIERARCHICAL adds a "manager"
  // agent at the top: it receives the run input, plans, then
  // delegates tasks to worker agents via the `delegate(agent_id, task)`
  // tool call. The runner consults `pipelineType` at dispatch time to
  // pick between executor paths.
  pipelineType PipelineType @default(SEQUENTIAL) @map("pipeline_type")
  // Manager agent for HIERARCHICAL pipelines. Required when
  // pipelineType=HIERARCHICAL, ignored otherwise.
  managerAgentId String? @map("manager_agent_id")
  // Max nested delegations per run (defence against an LLM that
  // delegates in a loop). Applied at runtime.
  maxDelegationDepth Int @default(3) @map("max_delegation_depth")
  schedule    String?  // cron expression for SCHEDULED trigger
  // Last time a SCHEDULED tick actually enqueued a run for this pipeline (E4).
  // Stamped by processScheduledTick; surfaced by GET /pipelines/scheduled next
  // to the JobScheduler-derived nextRunAt. NULL until the first scheduled fire.
  lastRunAt   DateTime? @map("last_run_at")
  steps       Json     @default("[]")  // pipeline step definitions
  config      Json     @default("{}")  // trigger-specific config (webhookTemplate, etc.)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    Run[]

  @@index([companyId])
  @@map("pipelines")
}

enum PipelineType {
  SEQUENTIAL
  HIERARCHICAL
}

// Per-agent graduated autonomy (Feature D6). See Agent.autonomy.
enum AgentAutonomy {
  SUPERVISED
  BALANCED
  AUTONOMOUS
}

model Run {
  id          String    @id @default(cuid())
  pipelineId  String    @map("pipeline_id")
  status      RunStatus @default(PENDING)
  trigger     String    @default("manual") // what triggered this run
  input       Json      @default("{}")
  output      Json?
  error       String?   @db.Text
  costUsd     Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  budgetUsd   Decimal?  @map("budget_usd") @db.Decimal(10, 6)
  // Step-group cursor for mid-run resume (Phase 1 HITL). Null = restart from
  // group 0 (legacy behaviour). Set by the runner as it advances.
  resumeCursor Int?     @map("resume_cursor")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  pipeline  Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  steps     RunStep[]
  approvals Approval[]
  steeringMessages SteeringMessage[]
  handoffs  HandoffLedger[]

  @@index([pipelineId])
  @@index([status])
  @@map("runs")
}

model RunStep {
  id          String        @id @default(cuid())
  runId       String        @map("run_id")
  agentId     String?       @map("agent_id")
  stepIndex   Int           @map("step_index")
  name        String
  status      RunStepStatus @default(PENDING)
  reasoning   String        @db.Text  // ZORUNLU — "neden bu kararı verdin"
  input       Json          @default("{}")
  output      Json?
  error       String?       @db.Text
  costUsd     Decimal?      @map("cost_usd") @db.Decimal(10, 6)
  // Forge P1 — real per-call token counts, for savings.service.ts's honest
  // "tokens saved" metric. Populated from the provider's actual
  // `usage.input_tokens` / `usage.output_tokens` (Anthropic; equivalent
  // fields on other providers) at the SAME call sites that already compute
  // cost_usd (modules/pipeline/executor.ts, modules/pipeline/
  // hierarchical-runner.ts). Nullable + additive: existing rows stay NULL
  // and savings.service falls back to its cost-based reconstruction for
  // them. cachedInputTokens is reserved for prompt-cache accounting (e.g.
  // Anthropic cache_read_input_tokens) — left NULL today since no call
  // site requests prompt caching yet.
  promptTokens      Int? @map("prompt_tokens")
  completionTokens  Int? @map("completion_tokens")
  cachedInputTokens Int? @map("cached_input_tokens")
  // Live turn-boundary checkpoint (E3 §2.2): the agent loop persists the
  // canonical ChatMessage[] transcript here at the END of every turn (tool
  // results included) on governed runs — { messages, turn, toolUseMode,
  // costSoFarUsd, truncated? }. Crash-safe carrier for handoffs: if the
  // process dies mid-step the last full turn survives. NULLed when the step
  // COMPLETEs (hygiene — the frozen copy lives in handoff_ledger.checkpoint).
  transcript  Json?
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  run       Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  toolCalls ToolCall[]
  handoffs  HandoffLedger[]

  @@index([runId])
  @@map("run_steps")
}

model ToolCall {
  id          String         @id @default(cuid())
  runStepId   String         @map("run_step_id")
  toolName    String         @map("tool_name")
  input       Json           @default("{}")
  output      Json?
  status      ToolCallStatus @default(PENDING)
  durationMs  Int?           @map("duration_ms")
  error       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  runStep RunStep @relation(fields: [runStepId], references: [id], onDelete: Cascade)

  @@index([runStepId])
  @@index([toolName])
  @@map("tool_calls")
}

// ─── APPROVALS ──────────────────────────────────────────

model Approval {
  id          String         @id @default(cuid())
  runId       String         @map("run_id")
  type        ApprovalType   @default(SPEND)
  status      ApprovalStatus @default(PENDING)
  description String         @db.Text
  amountUsd   Decimal?       @map("amount_usd") @db.Decimal(10, 2)
  metadata    Json           @default("{}")
  decidedBy   String?        @map("decided_by")
  decidedAt   DateTime?      @map("decided_at")
  expiresAt   DateTime?      @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  run     Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  user    User? @relation(fields: [decidedBy], references: [id])

  @@index([runId])
  @@index([status])
  @@map("approvals")
}

// ─── MID-RUN STEERING / HITL (Phase 1 — the v2 moat) ────
//
// Operator → agent messages queued against a running run, drained by the
// agent loop at the top of each turn. INPUT answers an agent's ask_user
// question (unblocks a WAITING_APPROVAL run); STEER injects guidance to
// redirect a (optionally specific) agent without stopping the run. Mirrors
// the SteeringMessage type in @ai-company-os/core.
model SteeringMessage {
  id            String       @id @default(cuid())
  runId         String       @map("run_id")
  // Route to a specific agent; null = applies to whichever agent is active.
  targetAgentId String?      @map("target_agent_id")
  kind          SteeringKind
  content       String       @db.Text
  createdBy     String?      @map("created_by") // operator userId (audit)
  consumedAt    DateTime?    @map("consumed_at") // set once the loop drains it
  createdAt     DateTime     @default(now()) @map("created_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, consumedAt])
  @@map("steering_messages")
}

enum SteeringKind {
  INPUT
  STEER
}

// ─── CROSS-MODEL HANDOFF LEDGER (E3) ────────────────────
//
// Persistent, cross-session record of a run being handed from one provider/
// model to another (E3 plan §2.1). E2's turn-boundary failover is in-memory
// and single-process; the ledger makes takeover state durable so ANOTHER
// process/provider can read it and resume from the interrupted turn. Built as
// its own model on runs/run_steps FKs — NOT on packages/memory (F-005:
// MemoryItem is company-scoped, gated by a 7-day/3-use promotion lifecycle,
// and the memory layer is fragmented across 3 implementations with 0 tests).

enum HandoffReason {
  MANUAL            // operatör "continue with X" istedi
  PROVIDER_FAILOVER // zincir FAILOVER-sınıfı hatayla tükendi (401/402/403, kota/kredi)
  PROVIDER_EXHAUSTED// retry-tükenmiş TRANSIENT (429/5xx) ile zincir bitti
  SESSION_LOST      // ileride: stale-run dedektörü (bu epikte yazan yok — enum yeri ayrılır)
}

enum HandoffStatus {
  OPEN       // devir bekliyor — checkpoint dondurulunca claimable
  CLAIMED    // devralan sağlayıcı atandı, run re-enqueue edildi
  COMPLETED  // devralınan koşu adımı/run'ı bitirdi
  FAILED     // devralınan koşu da öldü (yeni handoff açılabilir)
  CANCELLED  // operatör iptal etti / rerun ile geçersizleşti
}

model HandoffLedger {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  runId          String        @map("run_id")
  runStepId      String?       @map("run_step_id") // kesilen adımın (ESKİ) satırı — devralma YENİ satır açar (B6.5)
  stepIndex      Int           @map("step_index")  // devralan executor'ın eşleşme anahtarı
  fromProvider   AIProvider    @map("from_provider")
  fromModel      String        @map("from_model")
  toProvider     AIProvider?   @map("to_provider") // CLAIMED'e kadar null
  toModel        String?       @map("to_model")
  reason         HandoffReason
  status         HandoffStatus @default(OPEN)
  // Devir anında DONDURULMUŞ kopya: { messages: ChatMessage[], turn: number,
  // toolUseMode, costSoFarUsd, systemPromptHash }. NULL = dondurma bekleniyor
  // (canlı loop interrupt'ı işleyene kadar — §2.3a). Kaynağı canlı checkpoint
  // (run_steps.transcript — §2.2); kopya = audit + devralanın okuduğu sabit gerçek.
  checkpoint     Json?
  // github.ts okumalarından best-effort snapshot (§2.4): { pr?: {number,state,
  // mergeable,headRef,headSha}, branch?: {name,aheadBy,behindBy,headSha}, capturedAt }.
  // GITHUB entegrasyonu yoksa null — handoff çalışmaya devam eder.
  gitState       Json?         @map("git_state")
  contextSummary String?       @map("context_summary") @db.Text
  createdBy      String?       @map("created_by") // userId | "system"
  claimedBy      String?       @map("claimed_by")
  claimedAt      DateTime?     @map("claimed_at")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  step   RunStep? @relation(fields: [runStepId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([runId])
  @@map("handoff_ledger")
}

// ─── MEMORY ─────────────────────────────────────────────

model MemoryItem {
  id          String       @id @default(cuid())
  companyId   String       @map("company_id")
  type        MemoryType
  status      MemoryStatus @default(CANDIDATE)
  content     String       @db.Text
  metadata    Json         @default("{}")
  source      String?      // which run/step created this
  confidence  Float        @default(0.5)
  useCount    Int          @default(0) @map("use_count")
  lastUsedAt  DateTime?    @map("last_used_at")
  promotedAt  DateTime?    @map("promoted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  embedding  MemoryEmbedding?
  edgesFrom  MemoryEdge[]      @relation("edge_from")
  edgesTo    MemoryEdge[]      @relation("edge_to")

  @@index([companyId])
  @@index([type, status])
  @@map("memory_items")
}

model MemoryEmbedding {
  id           String @id @default(cuid())
  memoryItemId String @unique @map("memory_item_id")
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime @default(now()) @map("created_at")

  memoryItem MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  // The pgvector HNSW index "memory_embeddings_embedding_hnsw_idx" lives
  // only in migration 20260423_pgvector_hnsw_index: Prisma has no HNSW index
  // type, so `migrate diff` always proposes dropping it. Delete that line from
  // any generated migration.
  @@map("memory_embeddings")
}

model MemoryEdge {
  id         String   @id @default(cuid())
  fromId     String   @map("from_id")
  toId       String   @map("to_id")
  relation   String   // e.g. "supports", "contradicts", "derives_from"
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now()) @map("created_at")

  from MemoryItem @relation("edge_from", fields: [fromId], references: [id], onDelete: Cascade)
  to   MemoryItem @relation("edge_to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
  @@map("memory_edges")
}

// ─── CRM ────────────────────────────────────────────────

model Contact {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  email         String?
  name          String?
  phone         String?
  linkedinUrl   String?  @map("linkedin_url")
  hubspotId     String?  @unique @map("hubspot_id")
  tags          String[] @default([])
  properties    Json     @default("{}")
  lastContactAt DateTime? @map("last_contact_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals       Deal[]
